{"number": 75, "metadata": {"number": 75, "nameAr": "سُورَةُ القِيَامَةِ", "nameEn": "Al-Qiyaama", "nameBn": "আল-কিয়ামাহ", "meaningEn": "The Resurrection", "meaningBn": "পুনরুত্থান দিবস", "ayahsCount": 40, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 5552, "endGlobalAyah": 5591}, "ayahs": [{"number": 1, "globalId": 5552, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ", "bengali": "আমি শপথ করি কেয়ামত দিবসের,", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 2, "globalId": 5553, "arabic": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ", "bengali": "আরও শপথ করি সেই মনের, যে নিজেকে ধিক্কার দেয়-", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 3, "globalId": 5554, "arabic": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ", "bengali": "মানুষ কি মনে করে যে আমি তার অস্থিসমূহ একত্রিত করব না?", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 4, "globalId": 5555, "arabic": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ", "bengali": "পরন্ত আমি তার অংগুলিগুলো পর্যন্ত সঠিকভাবে সন্নিবেশিত করতে সক্ষম।", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 5, "globalId": 5556, "arabic": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ", "bengali": "বরং মানুষ তার ভবিষ্যত জীবনেও ধৃষ্টতা করতে চায়", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 6, "globalId": 5557, "arabic": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ", "bengali": "সে প্রশ্ন করে-কেয়ামত দিবস কবে?", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 7, "globalId": 5558, "arabic": "فَإِذَا بَرِقَ ٱلْبَصَرُ", "bengali": "যখন দৃষ্টি চমকে যাবে,", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 8, "globalId": 5559, "arabic": "وَخَسَفَ ٱلْقَمَرُ", "bengali": "চন্দ্র জ্যোতিহীন হয়ে যাবে।", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 9, "globalId": 5560, "arabic": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ", "bengali": "এবং সূর্য ও চন্দ্রকে একত্রিত করা হবে-", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 10, "globalId": 5561, "arabic": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ", "bengali": "সে দিন মানুষ বলবেঃ পলায়নের জায়গা কোথায় ?", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 11, "globalId": 5562, "arabic": "كَلَّا لَا وَزَرَ", "bengali": "না কোথাও আশ্রয়স্থল নেই।", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 12, "globalId": 5563, "arabic": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ", "bengali": "আপনার পালনকর্তার কাছেই সেদিন ঠাঁই হবে।", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 13, "globalId": 5564, "arabic": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ", "bengali": "সেদিন মানুষকে অবহিত করা হবে সে যা সামনে প্রেরণ করেছে ও পশ্চাতে ছেড়ে দিয়েছে।", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 14, "globalId": 5565, "arabic": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ", "bengali": "বরং মানুষ নিজেই তার নিজের সম্পর্কে চক্ষুমান।", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 15, "globalId": 5566, "arabic": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ", "bengali": "যদিও সে তার অজুহাত পেশ করতে চাইবে।", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 16, "globalId": 5567, "arabic": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ", "bengali": "তাড়াতাড়ি শিখে নেয়ার জন্যে আপনি দ্রুত ওহী আবৃত্তি করবেন না।", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 17, "globalId": 5568, "arabic": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ", "bengali": "এর সংরক্ষণ ও পাঠ আমারই দায়িত্ব।", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 18, "globalId": 5569, "arabic": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ", "bengali": "অতঃপর আমি যখন তা পাঠ করি, তখন আপনি সেই পাঠের অনুসরণ করুন।", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 19, "globalId": 5570, "arabic": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ", "bengali": "এরপর বিশদ বর্ণনা আমারই দায়িত্ব।", "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "sajda": false}, {"number": 20, "globalId": 5571, "arabic": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ", "bengali": "কখনও না, বরং তোমরা পার্থিব জীবনকে ভালবাস", "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "sajda": false}, {"number": 21, "globalId": 5572, "arabic": "وَتَذَرُونَ ٱلْءَاخِرَةَ", "bengali": "এবং পরকালকে উপেক্ষা কর।", "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "sajda": false}, {"number": 22, "globalId": 5573, "arabic": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ", "bengali": "সেদিন অনেক মুখমন্ডল উজ্জ্বল হবে।", "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "sajda": false}, {"number": 23, "globalId": 5574, "arabic": "إِلَىٰ رَبِّهَا نَاظِرَةٌۭ", "bengali": "তারা তার পালনকর্তার দিকে তাকিয়ে থাকবে।", "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "sajda": false}, {"number": 24, "globalId": 5575, "arabic": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ", "bengali": "আর অনেক মুখমন্ডল সেদিন উদাস হয়ে পড়বে।", "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "sajda": false}, {"number": 25, "globalId": 5576, "arabic": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ", "bengali": "তারা ধারণা করবে যে, তাদের সাথে কোমর-ভাঙ্গা আচরণ করা হবে।", "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "sajda": false}, {"number": 26, "globalId": 5577, "arabic": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ", "bengali": "কখনও না, যখন প্রাণ কন্ঠাগত হবে।", "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "sajda": false}, {"number": 27, "globalId": 5578, "arabic": "وَقِيلَ مَنْ ۜ رَاقٍۢ", "bengali": "এবং বলা হবে, কে ঝাড়বে", "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "sajda": false}, {"number": 28, "globalId": 5579, "arabic": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ", "bengali": "এবং সে মনে করবে যে, বিদায়ের ক্ষণ এসে গেছে।", "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "sajda": false}, {"number": 29, "globalId": 5580, "arabic": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ", "bengali": "এবং গোছা গোছার সাথে জড়িত হয়ে যাবে।", "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "sajda": false}, {"number": 30, "globalId": 5581, "arabic": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ", "bengali": "সেদিন, আপনার পালনকর্তার নিকট সবকিছু নীত হবে।", "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "sajda": false}, {"number": 31, "globalId": 5582, "arabic": "فَلَا صَدَّقَ وَلَا صَلَّىٰ", "bengali": "সে বিশ্বাস করেনি এবং নামায পড়েনি;", "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "sajda": false}, {"number": 32, "globalId": 5583, "arabic": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ", "bengali": "পরন্ত মিথ্যারোপ করেছে ও পৃষ্ঠ প্রদর্শন করেছে।", "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "sajda": false}, {"number": 33, "globalId": 5584, "arabic": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ", "bengali": "অতঃপর সে দম্ভভরে পরিবার-পরিজনের নিকট ফিরে গিয়েছে।", "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "sajda": false}, {"number": 34, "globalId": 5585, "arabic": "أَوْلَىٰ لَكَ فَأَوْلَىٰ", "bengali": "তোমার দুর্ভোগের উপর দুর্ভোগ।", "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "sajda": false}, {"number": 35, "globalId": 5586, "arabic": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ", "bengali": "অতঃপর, তোমার দুর্ভোগের উপর দূর্ভোগ।", "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "sajda": false}, {"number": 36, "globalId": 5587, "arabic": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى", "bengali": "মানুষ কি মনে করে যে, তাকে এমনি ছেড়ে দেয়া হবে?", "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "sajda": false}, {"number": 37, "globalId": 5588, "arabic": "أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ", "bengali": "সে কি স্খলিত বীর্য ছিল না?", "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "sajda": false}, {"number": 38, "globalId": 5589, "arabic": "ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ", "bengali": "অতঃপর সে ছিল রক্তপিন্ড, অতঃপর আল্লাহ তাকে সৃষ্টি করেছেন এবং সুবিন্যস্ত করেছেন।", "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "sajda": false}, {"number": 39, "globalId": 5590, "arabic": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "bengali": "অতঃপর তা থেকে সৃষ্টি করেছেন যুগল নর ও নারী।", "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "sajda": false}, {"number": 40, "globalId": 5591, "arabic": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ", "bengali": "তবুও কি সেই আল্লাহ মৃতদেরকে জীবিত করতে সক্ষম নন?", "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "sajda": false}]}