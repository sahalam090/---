{"number": 101, "metadata": {"number": 101, "nameAr": "سُورَةُ القَارِعَةِ", "nameEn": "Al-Qaari'a", "nameBn": "আল-কারিয়াহ", "meaningEn": "The Calamity", "meaningBn": "মহা বিপদ", "ayahsCount": 11, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 6158, "endGlobalAyah": 6168}, "ayahs": [{"number": 1, "globalId": 6158, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ", "bengali": "করাঘাতকারী,", "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false}, {"number": 2, "globalId": 6159, "arabic": "مَا ٱلْقَارِعَةُ", "bengali": "করাঘাতকারী কি?", "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false}, {"number": 3, "globalId": 6160, "arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ", "bengali": "করাঘাতকারী সম্পর্কে আপনি কি জানেন ?", "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false}, {"number": 4, "globalId": 6161, "arabic": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ", "bengali": "যেদিন মানুষ হবে বিক্ষিপ্ত পতংগের মত", "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false}, {"number": 5, "globalId": 6162, "arabic": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ", "bengali": "এবং পর্বতমালা হবে ধুনিত রঙ্গীন পশমের মত।", "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false}, {"number": 6, "globalId": 6163, "arabic": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ", "bengali": "অতএব যার পাল্লা ভারী হবে,", "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false}, {"number": 7, "globalId": 6164, "arabic": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ", "bengali": "সে সুখীজীবন যাপন করবে।", "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false}, {"number": 8, "globalId": 6165, "arabic": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ", "bengali": "আর যার পাল্লা হালকা হবে,", "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false}, {"number": 9, "globalId": 6166, "arabic": "فَأُمُّهُۥ هَاوِيَةٌۭ", "bengali": "তার ঠিকানা হবে হাবিয়া।", "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false}, {"number": 10, "globalId": 6167, "arabic": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ", "bengali": "আপনি জানেন তা কি?", "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false}, {"number": 11, "globalId": 6168, "arabic": "نَارٌ حَامِيَةٌۢ", "bengali": "প্রজ্জ্বলিত অগ্নি!", "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false}]}