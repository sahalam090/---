{"number": 113, "metadata": {"number": 113, "nameAr": "سُورَةُ الفَلَقِ", "nameEn": "Al-Falaq", "nameBn": "আল-ফালাক", "meaningEn": "The Dawn", "meaningBn": "ঊষা", "ayahsCount": 5, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 6226, "endGlobalAyah": 6230}, "ayahs": [{"number": 1, "globalId": 6226, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ", "bengali": "বলুন, আমি আশ্রয় গ্রহণ করছি প্রভাতের পালনকর্তার,", "juz": 30, "manzil": 7, "page": 604, "ruku": 555, "sajda": false}, {"number": 2, "globalId": 6227, "arabic": "مِن شَرِّ مَا خَلَقَ", "bengali": "তিনি যা সৃষ্টি করেছেন, তার অনিষ্ট থেকে,", "juz": 30, "manzil": 7, "page": 604, "ruku": 555, "sajda": false}, {"number": 3, "globalId": 6228, "arabic": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ", "bengali": "অন্ধকার রাত্রির অনিষ্ট থেকে, যখন তা সমাগত হয়,", "juz": 30, "manzil": 7, "page": 604, "ruku": 555, "sajda": false}, {"number": 4, "globalId": 6229, "arabic": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ", "bengali": "গ্রন্থিতে ফুঁৎকার দিয়ে জাদুকারিনীদের অনিষ্ট থেকে", "juz": 30, "manzil": 7, "page": 604, "ruku": 555, "sajda": false}, {"number": 5, "globalId": 6230, "arabic": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ", "bengali": "এবং হিংসুকের অনিষ্ট থেকে যখন সে হিংসা করে।", "juz": 30, "manzil": 7, "page": 604, "ruku": 555, "sajda": false}]}