{"number": 93, "metadata": {"number": 93, "nameAr": "سُورَةُ الضُّحَىٰ", "nameEn": "Ad-Dhuhaa", "nameBn": "আদ-দুহা", "meaningEn": "The Morning Hours", "meaningBn": "পূর্বাহ্ণ", "ayahsCount": 11, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 6080, "endGlobalAyah": 6090}, "ayahs": [{"number": 1, "globalId": 6080, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ", "bengali": "শপথ পূর্বাহ্নের,", "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false}, {"number": 2, "globalId": 6081, "arabic": "وَٱلَّيْلِ إِذَا سَجَىٰ", "bengali": "শপথ রাত্রির যখন তা গভীর হয়,", "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false}, {"number": 3, "globalId": 6082, "arabic": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ", "bengali": "আপনার পালনকর্তা আপনাকে ত্যাগ করেনি এবং আপনার প্রতি বিরূপও হননি।", "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false}, {"number": 4, "globalId": 6083, "arabic": "وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ", "bengali": "আপনার জন্যে পরকাল ইহকাল অপেক্ষা শ্রেয়।", "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false}, {"number": 5, "globalId": 6084, "arabic": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ", "bengali": "আপনার পালনকর্তা সত্বরই আপনাকে দান করবেন, অতঃপর আপনি সন্তুষ্ট হবেন।", "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false}, {"number": 6, "globalId": 6085, "arabic": "أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ", "bengali": "তিনি কি আপনাকে এতীমরূপে পাননি? অতঃপর তিনি আশ্রয় দিয়েছেন।", "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false}, {"number": 7, "globalId": 6086, "arabic": "وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ", "bengali": "তিনি আপনাকে পেয়েছেন পথহারা, অতঃপর পথপ্রদর্শন করেছেন।", "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false}, {"number": 8, "globalId": 6087, "arabic": "وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ", "bengali": "তিনি আপনাকে পেয়েছেন নিঃস্ব, অতঃপর অভাবমুক্ত করেছেন।", "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false}, {"number": 9, "globalId": 6088, "arabic": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ", "bengali": "সুতরাং আপনি এতীমের প্রতি কঠোর হবেন না;", "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false}, {"number": 10, "globalId": 6089, "arabic": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ", "bengali": "সওয়ালকারীকে ধমক দেবেন না।", "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false}, {"number": 11, "globalId": 6090, "arabic": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ", "bengali": "এবং আপনার পালনকর্তার নেয়ামতের কথা প্রকাশ করুন।", "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false}]}