{"number": 111, "metadata": {"number": 111, "nameAr": "سُورَةُ المَسَدِ", "nameEn": "Al-Masad", "nameBn": "আল-মাসাদ", "meaningEn": "The Palm Fibre", "meaningBn": "খেজুরের আঁশ", "ayahsCount": 5, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 6217, "endGlobalAyah": 6221}, "ayahs": [{"number": 1, "globalId": 6217, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ", "bengali": "আবু লাহাবের হস্তদ্বয় ধ্বংস হোক এবং ধ্বংস হোক সে নিজে,", "juz": 30, "manzil": 7, "page": 603, "ruku": 553, "sajda": false}, {"number": 2, "globalId": 6218, "arabic": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ", "bengali": "কোন কাজে আসেনি তার ধন-সম্পদ ও যা সে উপার্জন করেছে।", "juz": 30, "manzil": 7, "page": 603, "ruku": 553, "sajda": false}, {"number": 3, "globalId": 6219, "arabic": "سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ", "bengali": "সত্বরই সে প্রবেশ করবে লেলিহান অগ্নিতে", "juz": 30, "manzil": 7, "page": 603, "ruku": 553, "sajda": false}, {"number": 4, "globalId": 6220, "arabic": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ", "bengali": "এবং তার স্ত্রীও-যে ইন্ধন বহন করে,", "juz": 30, "manzil": 7, "page": 603, "ruku": 553, "sajda": false}, {"number": 5, "globalId": 6221, "arabic": "فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ", "bengali": "তার গলদেশে খর্জুরের রশি নিয়ে।", "juz": 30, "manzil": 7, "page": 603, "ruku": 553, "sajda": false}]}