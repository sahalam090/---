{"number": 102, "metadata": {"number": 102, "nameAr": "سُورَةُ التَّكَاثُرِ", "nameEn": "At-Takaathur", "nameBn": "আত-তাকাসুর", "meaningEn": "Competition", "meaningBn": "প্রাচুর্যের প্রতিযোগিতা", "ayahsCount": 8, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 6169, "endGlobalAyah": 6176}, "ayahs": [{"number": 1, "globalId": 6169, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ", "bengali": "প্রাচুর্যের লালসা তোমাদেরকে গাফেল রাখে,", "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false}, {"number": 2, "globalId": 6170, "arabic": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ", "bengali": "এমনকি, তোমরা কবরস্থানে পৌছে যাও।", "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false}, {"number": 3, "globalId": 6171, "arabic": "كَلَّا سَوْفَ تَعْلَمُونَ", "bengali": "এটা কখনও উচিত নয়। তোমরা সত্ত্বরই জেনে নেবে।", "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false}, {"number": 4, "globalId": 6172, "arabic": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ", "bengali": "অতঃপর এটা কখনও উচিত নয়। তোমরা সত্ত্বরই জেনে নেবে।", "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false}, {"number": 5, "globalId": 6173, "arabic": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ", "bengali": "কখনই নয়; যদি তোমরা নিশ্চিত জানতে।", "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false}, {"number": 6, "globalId": 6174, "arabic": "لَتَرَوُنَّ ٱلْجَحِيمَ", "bengali": "তোমরা অবশ্যই জাহান্নাম দেখবে,", "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false}, {"number": 7, "globalId": 6175, "arabic": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ", "bengali": "অতঃপর তোমরা তা অবশ্যই দেখবে দিব্য প্রত্যয়ে,", "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false}, {"number": 8, "globalId": 6176, "arabic": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ", "bengali": "এরপর অবশ্যই সেদিন তোমরা নেয়ামত সম্পর্কে জিজ্ঞাসিত হবে।", "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false}]}