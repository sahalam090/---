{"number": 104, "metadata": {"number": 104, "nameAr": "سُورَةُ الهُمَزَةِ", "nameEn": "Al-Humaza", "nameBn": "আল-হুমাযাহ", "meaningEn": "The Traducer", "meaningBn": "পরনিন্দাকারী", "ayahsCount": 9, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 6180, "endGlobalAyah": 6188}, "ayahs": [{"number": 1, "globalId": 6180, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ", "bengali": "প্রত্যেক পশ্চাতে ও সম্মুখে পরনিন্দাকারীর দুর্ভোগ,", "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false}, {"number": 2, "globalId": 6181, "arabic": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ", "bengali": "যে অর্থ সঞ্চিত করে ও গণনা করে", "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false}, {"number": 3, "globalId": 6182, "arabic": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ", "bengali": "সে মনে করে যে, তার অর্থ চিরকাল তার সাথে থাকবে!", "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false}, {"number": 4, "globalId": 6183, "arabic": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ", "bengali": "কখনও না, সে অবশ্যই নিক্ষিপ্ত হবে পিষ্টকারীর মধ্যে।", "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false}, {"number": 5, "globalId": 6184, "arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ", "bengali": "আপনি কি জানেন, পিষ্টকারী কি?", "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false}, {"number": 6, "globalId": 6185, "arabic": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ", "bengali": "এটা আল্লাহর প্রজ্জ্বলিত অগ্নি,", "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false}, {"number": 7, "globalId": 6186, "arabic": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ", "bengali": "যা হৃদয় পর্যন্ত পৌছবে।", "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false}, {"number": 8, "globalId": 6187, "arabic": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ", "bengali": "এতে তাদেরকে বেঁধে দেয়া হবে,", "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false}, {"number": 9, "globalId": 6188, "arabic": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ", "bengali": "লম্বা লম্বা খুঁটিতে।", "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false}]}