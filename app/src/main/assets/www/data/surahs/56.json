{"number": 56, "metadata": {"number": 56, "nameAr": "سُورَةُ الوَاقِعَةِ", "nameEn": "Al-Waaqia", "nameBn": "আল-ওয়াকিয়াহ", "meaningEn": "The Inevitable", "meaningBn": "সংঘটিত ঘটনা", "ayahsCount": 96, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 4980, "endGlobalAyah": 5075}, "ayahs": [{"number": 1, "globalId": 4980, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ", "bengali": "যখন কিয়ামতের ঘটনা ঘটবে,", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 2, "globalId": 4981, "arabic": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ", "bengali": "যার বাস্তবতায় কোন সংশয় নেই।", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 3, "globalId": 4982, "arabic": "خَافِضَةٌۭ رَّافِعَةٌ", "bengali": "এটা নীচু করে দেবে, সমুন্নত করে দেবে।", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 4, "globalId": 4983, "arabic": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّۭا", "bengali": "যখন প্রবলভাবে প্রকম্পিত হবে পৃথিবী।", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 5, "globalId": 4984, "arabic": "وَبُسَّتِ ٱلْجِبَالُ بَسًّۭا", "bengali": "এবং পর্বতমালা ভেঙ্গে চুরমার হয়ে যাবে।", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 6, "globalId": 4985, "arabic": "فَكَانَتْ هَبَآءًۭ مُّنۢبَثًّۭا", "bengali": "অতঃপর তা হয়ে যাবে উৎক্ষিপ্ত ধূলিকণা।", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 7, "globalId": 4986, "arabic": "وَكُنتُمْ أَزْوَٰجًۭا ثَلَٰثَةًۭ", "bengali": "এবং তোমরা তিনভাবে বিভক্ত হয়ে পড়বে।", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 8, "globalId": 4987, "arabic": "فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ", "bengali": "যারা ডান দিকে, কত ভাগ্যবান তারা।", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 9, "globalId": 4988, "arabic": "وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ", "bengali": "এবং যারা বামদিকে, কত হতভাগা তারা।", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 10, "globalId": 4989, "arabic": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ", "bengali": "অগ্রবর্তীগণ তো অগ্রবর্তীই।", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 11, "globalId": 4990, "arabic": "أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ", "bengali": "তারাই নৈকট্যশীল,", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 12, "globalId": 4991, "arabic": "فِى جَنَّٰتِ ٱلنَّعِيمِ", "bengali": "অবদানের উদ্যানসমূহে,", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 13, "globalId": 4992, "arabic": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ", "bengali": "তারা একদল পূর্ববর্তীদের মধ্য থেকে।", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 14, "globalId": 4993, "arabic": "وَقَلِيلٌۭ مِّنَ ٱلْءَاخِرِينَ", "bengali": "এবং অল্পসংখ্যক পরবর্তীদের মধ্যে থেকে।", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 15, "globalId": 4994, "arabic": "عَلَىٰ سُرُرٍۢ مَّوْضُونَةٍۢ", "bengali": "স্বর্ণ খচিত সিংহাসন।", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 16, "globalId": 4995, "arabic": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ", "bengali": "তারা তাতে হেলান দিয়ে বসবে পরস্পর মুখোমুখি হয়ে।", "juz": 27, "manzil": 7, "page": 534, "ruku": 469, "sajda": false}, {"number": 17, "globalId": 4996, "arabic": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ", "bengali": "তাদের কাছে ঘোরাফেরা করবে চির কিশোরেরা।", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 18, "globalId": 4997, "arabic": "بِأَكْوَابٍۢ وَأَبَارِيقَ وَكَأْسٍۢ مِّن مَّعِينٍۢ", "bengali": "পানপাত্র কুঁজা ও খাঁটি সূরাপূর্ণ পেয়ালা হাতে নিয়ে,", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 19, "globalId": 4998, "arabic": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ", "bengali": "যা পান করলে তাদের শিরঃপীড়া হবে না এবং বিকারগ্রস্ত ও হবে না।", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 20, "globalId": 4999, "arabic": "وَفَٰكِهَةٍۢ مِّمَّا يَتَخَيَّرُونَ", "bengali": "আর তাদের পছন্দমত ফল-মুল নিয়ে,", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 21, "globalId": 5000, "arabic": "وَلَحْمِ طَيْرٍۢ مِّمَّا يَشْتَهُونَ", "bengali": "এবং রুচিমত পাখীর মাংস নিয়ে।", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 22, "globalId": 5001, "arabic": "وَحُورٌ عِينٌۭ", "bengali": "তথায় থাকবে আনতনয়না হুরগণ,", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 23, "globalId": 5002, "arabic": "كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ", "bengali": "আবরণে রক্ষিত মোতির ন্যায়,", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 24, "globalId": 5003, "arabic": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ", "bengali": "তারা যা কিছু করত, তার পুরস্কারস্বরূপ।", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 25, "globalId": 5004, "arabic": "لَا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا تَأْثِيمًا", "bengali": "তারা তথায় অবান্তর ও কোন খারাপ কথা শুনবে না।", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 26, "globalId": 5005, "arabic": "إِلَّا قِيلًۭا سَلَٰمًۭا سَلَٰمًۭا", "bengali": "কিন্তু শুনবে সালাম আর সালাম।", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 27, "globalId": 5006, "arabic": "وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ", "bengali": "যারা ডান দিকে থাকবে, তারা কত ভাগ্যবান।", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 28, "globalId": 5007, "arabic": "فِى سِدْرٍۢ مَّخْضُودٍۢ", "bengali": "তারা থাকবে কাঁটাবিহীন বদরিকা বৃক্ষে।", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 29, "globalId": 5008, "arabic": "وَطَلْحٍۢ مَّنضُودٍۢ", "bengali": "এবং কাঁদি কাঁদি কলায়,", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 30, "globalId": 5009, "arabic": "وَظِلٍّۢ مَّمْدُودٍۢ", "bengali": "এবং দীর্ঘ ছায়ায়।", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 31, "globalId": 5010, "arabic": "وَمَآءٍۢ مَّسْكُوبٍۢ", "bengali": "এবং প্রবাহিত পানিতে,", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 32, "globalId": 5011, "arabic": "وَفَٰكِهَةٍۢ كَثِيرَةٍۢ", "bengali": "ও প্রচুর ফল-মূলে,", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 33, "globalId": 5012, "arabic": "لَّا مَقْطُوعَةٍۢ وَلَا مَمْنُوعَةٍۢ", "bengali": "যা শেষ হবার নয় এবং নিষিদ্ধ ও নয়,", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 34, "globalId": 5013, "arabic": "وَفُرُشٍۢ مَّرْفُوعَةٍ", "bengali": "আর থাকবে সমুন্নত শয্যায়।", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 35, "globalId": 5014, "arabic": "إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءًۭ", "bengali": "আমি জান্নাতী রমণীগণকে বিশেষরূপে সৃষ্টি করেছি।", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 36, "globalId": 5015, "arabic": "فَجَعَلْنَٰهُنَّ أَبْكَارًا", "bengali": "অতঃপর তাদেরকে করেছি চিরকুমারী।", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 37, "globalId": 5016, "arabic": "عُرُبًا أَتْرَابًۭا", "bengali": "কামিনী, সমবয়স্কা।", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 38, "globalId": 5017, "arabic": "لِّأَصْحَٰبِ ٱلْيَمِينِ", "bengali": "ডান দিকের লোকদের জন্যে।", "juz": 27, "manzil": 7, "page": 535, "ruku": 469, "sajda": false}, {"number": 39, "globalId": 5018, "arabic": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ", "bengali": "তাদের একদল হবে পূর্ববর্তীদের মধ্য থেকে।", "juz": 27, "manzil": 7, "page": 535, "ruku": 470, "sajda": false}, {"number": 40, "globalId": 5019, "arabic": "وَثُلَّةٌۭ مِّنَ ٱلْءَاخِرِينَ", "bengali": "এবং একদল পরবর্তীদের মধ্য থেকে।", "juz": 27, "manzil": 7, "page": 535, "ruku": 470, "sajda": false}, {"number": 41, "globalId": 5020, "arabic": "وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ", "bengali": "বামপার্শ্বস্থ লোক, কত না হতভাগা তারা।", "juz": 27, "manzil": 7, "page": 535, "ruku": 470, "sajda": false}, {"number": 42, "globalId": 5021, "arabic": "فِى سَمُومٍۢ وَحَمِيمٍۢ", "bengali": "তারা থাকবে প্রখর বাষ্পে এবং উত্তপ্ত পানিতে,", "juz": 27, "manzil": 7, "page": 535, "ruku": 470, "sajda": false}, {"number": 43, "globalId": 5022, "arabic": "وَظِلٍّۢ مِّن يَحْمُومٍۢ", "bengali": "এবং ধুম্রকুঞ্জের ছায়ায়।", "juz": 27, "manzil": 7, "page": 535, "ruku": 470, "sajda": false}, {"number": 44, "globalId": 5023, "arabic": "لَّا بَارِدٍۢ وَلَا كَرِيمٍ", "bengali": "যা শীতল নয় এবং আরামদায়কও নয়।", "juz": 27, "manzil": 7, "page": 535, "ruku": 470, "sajda": false}, {"number": 45, "globalId": 5024, "arabic": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ", "bengali": "তারা ইতিপূর্বে স্বাচ্ছন্দ্যশীল ছিল।", "juz": 27, "manzil": 7, "page": 535, "ruku": 470, "sajda": false}, {"number": 46, "globalId": 5025, "arabic": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ", "bengali": "তারা সদাসর্বদা ঘোরতর পাপকর্মে ডুবে থাকত।", "juz": 27, "manzil": 7, "page": 535, "ruku": 470, "sajda": false}, {"number": 47, "globalId": 5026, "arabic": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ", "bengali": "তারা বলতঃ আমরা যখন মরে অস্থি ও মৃত্তিকায় পরিণত হয়ে যাব, তখনও কি পুনরুত্থিত হব?", "juz": 27, "manzil": 7, "page": 535, "ruku": 470, "sajda": false}, {"number": 48, "globalId": 5027, "arabic": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ", "bengali": "এবং আমাদের পূর্বপুরুষগণও!", "juz": 27, "manzil": 7, "page": 535, "ruku": 470, "sajda": false}, {"number": 49, "globalId": 5028, "arabic": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْءَاخِرِينَ", "bengali": "বলুনঃ পূর্ববর্তী ও পরবর্তীগণ,", "juz": 27, "manzil": 7, "page": 535, "ruku": 470, "sajda": false}, {"number": 50, "globalId": 5029, "arabic": "لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍۢ مَّعْلُومٍۢ", "bengali": "সবাই একত্রিত হবে এক নির্দিষ্ট দিনের নির্দিষ্ট সময়ে।", "juz": 27, "manzil": 7, "page": 535, "ruku": 470, "sajda": false}, {"number": 51, "globalId": 5030, "arabic": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ", "bengali": "অতঃপর হে পথভ্রষ্ট, মিথ্যারোপকারীগণ।", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 52, "globalId": 5031, "arabic": "لَءَاكِلُونَ مِن شَجَرٍۢ مِّن زَقُّومٍۢ", "bengali": "তোমরা অবশ্যই ভক্ষণ করবে যাক্কুম বৃক্ষ থেকে,", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 53, "globalId": 5032, "arabic": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ", "bengali": "অতঃপর তা দ্বারা উদর পূর্ণ করবে,", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 54, "globalId": 5033, "arabic": "فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ", "bengali": "অতঃপর তার উপর পান করবে উত্তপ্ত পানি।", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 55, "globalId": 5034, "arabic": "فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ", "bengali": "পান করবে পিপাসিত উটের ন্যায়।", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 56, "globalId": 5035, "arabic": "هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ", "bengali": "কেয়ামতের দিন এটাই হবে তাদের আপ্যায়ন।", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 57, "globalId": 5036, "arabic": "نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ", "bengali": "আমি সৃষ্টি করেছি তোমাদেরকে। অতঃপর কেন তোমরা তা সত্য বলে বিশ্বাস কর না।", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 58, "globalId": 5037, "arabic": "أَفَرَءَيْتُم مَّا تُمْنُونَ", "bengali": "তোমরা কি ভেবে দেখেছ, তোমাদের বীর্যপাত সম্পর্কে।", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 59, "globalId": 5038, "arabic": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ", "bengali": "তোমরা তাকে সৃষ্টি কর, না আমি সৃষ্টি করি?", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 60, "globalId": 5039, "arabic": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ", "bengali": "আমি তোমাদের মৃত্যুকাল নির্ধারিত করেছি এবং আমি অক্ষম নই।", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 61, "globalId": 5040, "arabic": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ", "bengali": "এ ব্যাপারে যে, তোমাদের পরিবর্তে তোমাদের মত লোককে নিয়ে আসি এবং তোমাদেরকে এমন করে দেই, যা তোমরা জান না।", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 62, "globalId": 5041, "arabic": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ", "bengali": "তোমরা অবগত হয়েছ প্রথম সৃষ্টি সম্পর্কে, তবে তোমরা অনুধাবন কর না কেন?", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 63, "globalId": 5042, "arabic": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ", "bengali": "তোমরা যে বীজ বপন কর, সে সম্পর্কে ভেবে দেখেছ কি?", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 64, "globalId": 5043, "arabic": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ", "bengali": "তোমরা তাকে উৎপন্ন কর, না আমি উৎপন্নকারী ?", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 65, "globalId": 5044, "arabic": "لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًۭا فَظَلْتُمْ تَفَكَّهُونَ", "bengali": "আমি ইচ্ছা করলে তাকে খড়কুটা করে দিতে পারি, অতঃপর হয়ে যাবে তোমরা বিস্ময়াবিষ্ট।", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 66, "globalId": 5045, "arabic": "إِنَّا لَمُغْرَمُونَ", "bengali": "বলবেঃ আমরা তো ঋণের চাপে পড়ে গেলাম;", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 67, "globalId": 5046, "arabic": "بَلْ نَحْنُ مَحْرُومُونَ", "bengali": "বরং আমরা হূত সর্বস্ব হয়ে পড়লাম।", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 68, "globalId": 5047, "arabic": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ", "bengali": "তোমরা যে পানি পান কর, সে সম্পর্কে ভেবে দেখেছ কি?", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 69, "globalId": 5048, "arabic": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ", "bengali": "তোমরা তা মেঘ থেকে নামিয়ে আন, না আমি বর্ষন করি?", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 70, "globalId": 5049, "arabic": "لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًۭا فَلَوْلَا تَشْكُرُونَ", "bengali": "আমি ইচ্ছা করলে তাকে লোনা করে দিতে পারি, অতঃপর তোমরা কেন কৃতজ্ঞতা প্রকাশ কর না?", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 71, "globalId": 5050, "arabic": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ", "bengali": "তোমরা যে অগ্নি প্রজ্জ্বলিত কর, সে সম্পর্কে ভেবে দেখেছ কি?", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 72, "globalId": 5051, "arabic": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ", "bengali": "তোমরা কি এর বৃক্ষ সৃষ্টি করেছ, না আমি সৃষ্টি করেছি ?", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 73, "globalId": 5052, "arabic": "نَحْنُ جَعَلْنَٰهَا تَذْكِرَةًۭ وَمَتَٰعًۭا لِّلْمُقْوِينَ", "bengali": "আমি সেই বৃক্ষকে করেছি স্মরণিকা এবং মরুবাসীদের জন্য সামগ্রী।", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 74, "globalId": 5053, "arabic": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ", "bengali": "অতএব, আপনি আপনার মহান পালনকর্তার নামে পবিত্রতা ঘোষণা করুন।", "juz": 27, "manzil": 7, "page": 536, "ruku": 470, "sajda": false}, {"number": 75, "globalId": 5054, "arabic": "۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ", "bengali": "অতএব, আমি তারকারাজির অস্তাচলের শপথ করছি,", "juz": 27, "manzil": 7, "page": 536, "ruku": 471, "sajda": false}, {"number": 76, "globalId": 5055, "arabic": "وَإِنَّهُۥ لَقَسَمٌۭ لَّوْ تَعْلَمُونَ عَظِيمٌ", "bengali": "নিশ্চয় এটা এক মহা শপথ-যদি তোমরা জানতে।", "juz": 27, "manzil": 7, "page": 536, "ruku": 471, "sajda": false}, {"number": 77, "globalId": 5056, "arabic": "إِنَّهُۥ لَقُرْءَانٌۭ كَرِيمٌۭ", "bengali": "নিশ্চয় এটা সম্মানিত কোরআন,", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 78, "globalId": 5057, "arabic": "فِى كِتَٰبٍۢ مَّكْنُونٍۢ", "bengali": "যা আছে এক গোপন কিতাবে,", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 79, "globalId": 5058, "arabic": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ", "bengali": "যারা পাক-পবিত্র, তারা ব্যতীত অন্য কেউ একে স্পর্শ করবে না।", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 80, "globalId": 5059, "arabic": "تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ", "bengali": "এটা বিশ্ব-পালনকর্তার পক্ষ থেকে অবতীর্ণ।", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 81, "globalId": 5060, "arabic": "أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ", "bengali": "তবুও কি তোমরা এই বাণীর প্রতি শৈথিল্য পদর্শন করবে?", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 82, "globalId": 5061, "arabic": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ", "bengali": "এবং একে মিথ্যা বলাকেই তোমরা তোমাদের ভূমিকায় পরিণত করবে?", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 83, "globalId": 5062, "arabic": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ", "bengali": "অতঃপর যখন কারও প্রাণ কন্ঠাগত হয়।", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 84, "globalId": 5063, "arabic": "وَأَنتُمْ حِينَئِذٍۢ تَنظُرُونَ", "bengali": "এবং তোমরা তাকিয়ে থাক,", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 85, "globalId": 5064, "arabic": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ", "bengali": "তখন আমি তোমাদের অপেক্ষা তার অধিক নিকটে থাকি; কিন্তু তোমরা দেখ না।", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 86, "globalId": 5065, "arabic": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ", "bengali": "যদি তোমাদের হিসাব-কিতাব না হওয়াই ঠিক হয়,", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 87, "globalId": 5066, "arabic": "تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَ", "bengali": "তবে তোমরা এই আত্মাকে ফিরাও না কেন, যদি তোমরা সত্যবাদী হও ?", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 88, "globalId": 5067, "arabic": "فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ", "bengali": "যদি সে নৈকট্যশীলদের একজন হয়;", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 89, "globalId": 5068, "arabic": "فَرَوْحٌۭ وَرَيْحَانٌۭ وَجَنَّتُ نَعِيمٍۢ", "bengali": "তবে তার জন্যে আছে সুখ, উত্তম রিযিক এবং নেয়ামতে ভরা উদ্যান।", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 90, "globalId": 5069, "arabic": "وَأَمَّآ إِن كَانَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ", "bengali": "আর যদি সে ডান পার্শ্বস্থদের একজন হয়,", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 91, "globalId": 5070, "arabic": "فَسَلَٰمٌۭ لَّكَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ", "bengali": "তবে তাকে বলা হবেঃ তোমার জন্যে ডানপার্শ্বসস্থদের পক্ষ থেকে সালাম।", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 92, "globalId": 5071, "arabic": "وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ", "bengali": "আর যদি সে পথভ্রষ্ট মিথ্যারোপকারীদের একজন হয়,", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 93, "globalId": 5072, "arabic": "فَنُزُلٌۭ مِّنْ حَمِيمٍۢ", "bengali": "তবে তার আপ্যায়ন হবে উত্তপ্ত পানি দ্বারা।", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 94, "globalId": 5073, "arabic": "وَتَصْلِيَةُ جَحِيمٍ", "bengali": "এবং সে নিক্ষিপ্ত হবে অগ্নিতে।", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 95, "globalId": 5074, "arabic": "إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ", "bengali": "এটা ধ্রুব সত্য।", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}, {"number": 96, "globalId": 5075, "arabic": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ", "bengali": "অতএব, আপনি আপনার মহান পালনকর্তার নামে পবিত্রতা ঘোষণা করুন।", "juz": 27, "manzil": 7, "page": 537, "ruku": 471, "sajda": false}]}