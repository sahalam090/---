{"number": 86, "metadata": {"number": 86, "nameAr": "سُورَةُ الطَّارِقِ", "nameEn": "At-Taariq", "nameBn": "আত-তারিক", "meaningEn": "The Morning Star", "meaningBn": "রাতের আগমনকারী", "ayahsCount": 17, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 5932, "endGlobalAyah": 5948}, "ayahs": [{"number": 1, "globalId": 5932, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ", "bengali": "শপথ আকাশের এবং রাত্রিতে আগমনকারীর।", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 2, "globalId": 5933, "arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ", "bengali": "আপনি জানেন, যে রাত্রিতে আসে সেটা কি?", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 3, "globalId": 5934, "arabic": "ٱلنَّجْمُ ٱلثَّاقِبُ", "bengali": "সেটা এক উজ্জ্বল নক্ষত্র।", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 4, "globalId": 5935, "arabic": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ", "bengali": "প্রত্যেকের উপর একজন তত্ত্বাবধায়ক রয়েছে।", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 5, "globalId": 5936, "arabic": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ", "bengali": "অতএব, মানুষের দেখা উচিত কি বস্তু থেকে সে সৃজিত হয়েছে।", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 6, "globalId": 5937, "arabic": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ", "bengali": "সে সৃজিত হয়েছে সবেগে স্খলিত পানি থেকে।", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 7, "globalId": 5938, "arabic": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ", "bengali": "এটা নির্গত হয় মেরুদন্ড ও বক্ষপাজরের মধ্য থেকে।", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 8, "globalId": 5939, "arabic": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ", "bengali": "নিশ্চয় তিনি তাকে ফিরিয়ে নিতে সক্ষম।", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 9, "globalId": 5940, "arabic": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ", "bengali": "যেদিন গোপন বিষয়াদি পরীক্ষিত হবে,", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 10, "globalId": 5941, "arabic": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ", "bengali": "সেদিন তার কোন শক্তি থাকবে না এবং সাহায্যকারীও থাকবে না।", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 11, "globalId": 5942, "arabic": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ", "bengali": "শপথ চক্রশীল আকাশের", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 12, "globalId": 5943, "arabic": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ", "bengali": "এবং বিদারনশীল পৃথিবীর", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 13, "globalId": 5944, "arabic": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ", "bengali": "নিশ্চয় কোরআন সত্য-মিথ্যার ফয়সালা।", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 14, "globalId": 5945, "arabic": "وَمَا هُوَ بِٱلْهَزْلِ", "bengali": "এবং এটা উপহাস নয়।", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 15, "globalId": 5946, "arabic": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا", "bengali": "তারা ভীষণ চক্রান্ত করে,", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 16, "globalId": 5947, "arabic": "وَأَكِيدُ كَيْدًۭا", "bengali": "আর আমিও কৌশল করি।", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}, {"number": 17, "globalId": 5948, "arabic": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا", "bengali": "অতএব, কাফেরদেরকে অবকাশ দিন, তাদেরকে অবকাশ দিন, কিছু দিনের জন্যে।", "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false}]}