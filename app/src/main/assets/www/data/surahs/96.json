{"number": 96, "metadata": {"number": 96, "nameAr": "سُورَةُ العَلَقِ", "nameEn": "Al-Alaq", "nameBn": "আল-আলাক", "meaningEn": "The Clot", "meaningBn": "রক্তপিণ্ড", "ayahsCount": 19, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 6107, "endGlobalAyah": 6125}, "ayahs": [{"number": 1, "globalId": 6107, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ", "bengali": "পাঠ করুন আপনার পালনকর্তার নামে যিনি সৃষ্টি করেছেন", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 2, "globalId": 6108, "arabic": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ", "bengali": "সৃষ্টি করেছেন মানুষকে জমাট রক্ত থেকে।", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 3, "globalId": 6109, "arabic": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ", "bengali": "পাঠ করুন, আপনার পালনকর্তা মহা দয়ালু,", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 4, "globalId": 6110, "arabic": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ", "bengali": "যিনি কলমের সাহায্যে শিক্ষা দিয়েছেন,", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 5, "globalId": 6111, "arabic": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ", "bengali": "শিক্ষা দিয়েছেন মানুষকে যা সে জানত না।", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 6, "globalId": 6112, "arabic": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ", "bengali": "সত্যি সত্যি মানুষ সীমালংঘন করে,", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 7, "globalId": 6113, "arabic": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ", "bengali": "এ কারণে যে, সে নিজেকে অভাবমুক্ত মনে করে।", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 8, "globalId": 6114, "arabic": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ", "bengali": "নিশ্চয় আপনার পালনকর্তার দিকেই প্রত্যাবর্তন হবে।", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 9, "globalId": 6115, "arabic": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ", "bengali": "আপনি কি তাকে দেখেছেন, যে নিষেধ করে", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 10, "globalId": 6116, "arabic": "عَبْدًا إِذَا صَلَّىٰٓ", "bengali": "এক বান্দাকে যখন সে নামায পড়ে?", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 11, "globalId": 6117, "arabic": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ", "bengali": "আপনি কি দেখেছেন যদি সে সৎপথে থাকে।", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 12, "globalId": 6118, "arabic": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ", "bengali": "অথবা খোদাভীতি শিক্ষা দেয়।", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 13, "globalId": 6119, "arabic": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ", "bengali": "আপনি কি দেখেছেন, যদি সে মিথ্যারোপ করে ও মুখ ফিরিয়ে নেয়।", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 14, "globalId": 6120, "arabic": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ", "bengali": "সে কি জানে না যে, আল্লাহ দেখেন?", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 15, "globalId": 6121, "arabic": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ", "bengali": "কখনই নয়, যদি সে বিরত না হয়, তবে আমি মস্তকের সামনের কেশগুচ্ছ ধরে হেঁচড়াবই-", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 16, "globalId": 6122, "arabic": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ", "bengali": "মিথ্যাচারী, পাপীর কেশগুচ্ছ।", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 17, "globalId": 6123, "arabic": "فَلْيَدْعُ نَادِيَهُۥ", "bengali": "অতএব, সে তার সভাসদদেরকে আহবান করুক।", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 18, "globalId": 6124, "arabic": "سَنَدْعُ ٱلزَّبَانِيَةَ", "bengali": "আমিও আহবান করব জাহান্নামের প্রহরীদেরকে", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false}, {"number": 19, "globalId": 6125, "arabic": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩", "bengali": "কখনই নয়, আপনি তার আনুগত্য করবেন না। আপনি সেজদা করুন ও আমার নৈকট্য অর্জন করুন।", "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": true}]}