mber": 20, "globalId": 5642, "arabic": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ", "bengali": "আমি কি তোমাদেরকে তুচ্ছ পানি থেকে সৃষ্টি করিনি?", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 21, "globalId": 5643, "arabic": "فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ", "bengali": "অতঃপর আমি তা রেখেছি এক সংরক্ষিত আধারে,", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 22, "globalId": 5644, "arabic": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ", "bengali": "এক নির্দিষ্টকাল পর্যন্ত,", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 23, "globalId": 5645, "arabic": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ", "bengali": "অতঃপর আমি পরিমিত আকারে সৃষ্টি করেছি, আমি কত সক্ষম স্রষ্টা?", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 24, "globalId": 5646, "arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "bengali": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 25, "globalId": 5647, "arabic": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا", "bengali": "আমি কি পৃথিবীকে সৃষ্টি করিনি ধারণকারিণীরূপে,", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 26, "globalId": 5648, "arabic": "أَحْيَآءًۭ وَأَمْوَٰتًۭا", "bengali": "জীবিত ও মৃতদেরকে?", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 27, "globalId": 5649, "arabic": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا", "bengali": "আমি তাতে স্থাপন করেছি মজবুত সুউচ্চ পর্বতমালা এবং পান করিয়েছি তোমাদেরকে তৃষ্ণা নিবারণকারী সুপেয় পানি।", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 28, "globalId": 5650, "arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "bengali": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 29, "globalId": 5651, "arabic": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ", "bengali": "চল তোমরা তারই দিকে, যাকে তোমরা মিথ্যা বলতে।", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 30, "globalId": 5652, "arabic": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ", "bengali": "চল তোমরা তিন কুন্ডলীবিশিষ্ট ছায়ার দিকে,", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 31, "globalId": 5653, "arabic": "لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ", "bengali": "যে ছায়া সুনিবিড় নয় এবং অগ্নির উত্তাপ থেকে রক্ষা করে না।", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 32, "globalId": 5654, "arabic": "إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ", "bengali": "এটা অট্টালিকা সদৃশ বৃহৎ স্ফুলিংগ নিক্ষেপ করবে।", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 33, "globalId": 5655, "arabic": "كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ", "bengali": "যেন সে পীতবর্ণ উষ্ট্রশ্রেণী।", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 34, "globalId": 5656, "arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "bengali": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 35, "globalId": 5657, "arabic": "هَٰذَا يَوْمُ لَا يَنطِقُونَ", "bengali": "এটা এমন দিন, যেদিন কেউ কথা বলবে না।", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 36, "globalId": 5658, "arabic": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ", "bengali": "এবং কাউকে তওবা করার অনুমতি দেয়া হবে না।", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 37, "globalId": 5659, "arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "bengali": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 38, "globalId": 5660, "arabic": "هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ", "bengali": "এটা বিচার দিবস, আমি তোমাদেরকে এবং তোমাদের পূর্ববর্তীদেরকে একত্রিত করেছি।", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 39, "globalId": 5661, "arabic": "فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ", "bengali": "অতএব, তোমাদের কোন অপকৌশল থাকলে তা প্রয়োগ কর আমার কাছে।", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 40, "globalId": 5662, "arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "bengali": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।", "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false}, {"number": 41, "globalId": 5663, "arabic": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ", "bengali": "নিশ্চয় খোদাভীরুরা থাকবে ছায়ায় এবং প্রস্রবণসমূহে-", "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false}, {"number": 42, "globalId": 5664, "arabic": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ", "bengali": "এবং তাদের বাঞ্ছিত ফল-মূলের মধ্যে।", "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false}, {"number": 43, "globalId": 5665, "arabic": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ", "bengali": "বলা হবেঃ তোমরা যা করতে তার বিনিময়ে তৃপ্তির সাথে পানাহার কর।", "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false}, {"number": 44, "globalId": 5666, "arabic": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ", "bengali": "এভাবেই আমি সৎকর্মশীলদেরকে পুরস্কৃত করে থাকি।", "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false}, {"number": 45, "globalId": 5667, "arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "bengali": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।", "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false}, {"number": 46, "globalId": 5668, "arabic": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ", "bengali": "কাফেরগণ, তোমরা কিছুদিন খেয়ে নাও এবং ভোগ করে নাও। তোমরা তো অপরাধী।", "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false}, {"number": 47, "globalId": 5669, "arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "bengali": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।", "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false}, {"number": 48, "globalId": 5670, "arabic": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ", "bengali": "যখন তাদেরকে বলা হয়, নত হও, তখন তারা নত হয় না।", "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false}, {"number": 49, "globalId": 5671, "arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "bengali": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।", "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false}, {"number": 50, "globalId": 5672, "arabic": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ", "bengali": "এখন কোন কথায় তারা এরপর বিশ্বাস স্থাপন করবে?", "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false}]}