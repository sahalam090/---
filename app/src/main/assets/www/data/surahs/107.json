{"number": 107, "metadata": {"number": 107, "nameAr": "سُورَةُ المَاعُونِ", "nameEn": "Al-Maa'un", "nameBn": "আল-মাউন", "meaningEn": "Almsgiving", "meaningBn": "নিত্যপ্রয়োজনীয় সাহায্য", "ayahsCount": 7, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 6198, "endGlobalAyah": 6204}, "ayahs": [{"number": 1, "globalId": 6198, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ", "bengali": "আপনি কি দেখেছেন তাকে, যে বিচারদিবসকে মিথ্যা বলে?", "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "sajda": false}, {"number": 2, "globalId": 6199, "arabic": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ", "bengali": "সে সেই ব্যক্তি, যে এতীমকে গলা ধাক্কা দেয়", "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "sajda": false}, {"number": 3, "globalId": 6200, "arabic": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "bengali": "এবং মিসকীনকে অন্ন দিতে উৎসাহিত করে না।", "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "sajda": false}, {"number": 4, "globalId": 6201, "arabic": "فَوَيْلٌۭ لِّلْمُصَلِّينَ", "bengali": "অতএব দুর্ভোগ সেসব নামাযীর,", "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "sajda": false}, {"number": 5, "globalId": 6202, "arabic": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ", "bengali": "যারা তাদের নামায সম্বন্ধে বে-খবর;", "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "sajda": false}, {"number": 6, "globalId": 6203, "arabic": "ٱلَّذِينَ هُمْ يُرَآءُونَ", "bengali": "যারা তা লোক-দেখানোর জন্য করে", "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "sajda": false}, {"number": 7, "globalId": 6204, "arabic": "وَيَمْنَعُونَ ٱلْمَاعُونَ", "bengali": "এবং নিত্য ব্যবহার্য্য বস্তু অন্যকে দেয় না।", "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "sajda": false}]}