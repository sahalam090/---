{"number": 95, "metadata": {"number": 95, "nameAr": "سُورَةُ التِّينِ", "nameEn": "At-Tin", "nameBn": "আত-তীন", "meaningEn": "The Fig", "meaningBn": "ডুমুর", "ayahsCount": 8, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 6099, "endGlobalAyah": 6106}, "ayahs": [{"number": 1, "globalId": 6099, "arabic": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ", "bengali": "শপথ আঞ্জীর (ডুমুর) ও যয়তুনের,", "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "sajda": false}, {"number": 2, "globalId": 6100, "arabic": "وَطُورِ سِينِينَ", "bengali": "এবং সিনাই প্রান্তরস্থ তূর পর্বতের,", "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "sajda": false}, {"number": 3, "globalId": 6101, "arabic": "وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ", "bengali": "এবং এই নিরাপদ নগরীর।", "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "sajda": false}, {"number": 4, "globalId": 6102, "arabic": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ", "bengali": "আমি সৃষ্টি করেছি মানুষকে সুন্দরতর অবয়বে।", "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "sajda": false}, {"number": 5, "globalId": 6103, "arabic": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ", "bengali": "অতঃপর তাকে ফিরিয়ে দিয়েছি নীচ থেকে নীচে।", "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "sajda": false}, {"number": 6, "globalId": 6104, "arabic": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ", "bengali": "কিন্তু যারা বিশ্বাস স্থাপন করেছে ও সৎকর্ম করেছে, তাদের জন্যে রয়েছে অশেষ পুরস্কার।", "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "sajda": false}, {"number": 7, "globalId": 6105, "arabic": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ", "bengali": "অতঃপর কেন তুমি অবিশ্বাস করছ কেয়ামতকে?", "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "sajda": false}, {"number": 8, "globalId": 6106, "arabic": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ", "bengali": "আল্লাহ কি বিচারকদের মধ্যে শ্রেষ্টতম বিচারক নন?", "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "sajda": false}]}