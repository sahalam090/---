{"number": 90, "metadata": {"number": 90, "nameAr": "سُورَةُ البَلَدِ", "nameEn": "Al-Balad", "nameBn": "আল-বালাদ", "meaningEn": "The City", "meaningBn": "নগরী", "ayahsCount": 20, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 6024, "endGlobalAyah": 6043}, "ayahs": [{"number": 1, "globalId": 6024, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ", "bengali": "আমি এই নগরীর শপথ করি", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 2, "globalId": 6025, "arabic": "وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ", "bengali": "এবং এই নগরীতে আপনার উপর কোন প্রতিবন্ধকতা নেই।", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 3, "globalId": 6026, "arabic": "وَوَالِدٍۢ وَمَا وَلَدَ", "bengali": "শপথ জনকের ও যা জন্ম দেয়।", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 4, "globalId": 6027, "arabic": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ", "bengali": "নিশ্চয় আমি মানুষকে শ্রমনির্ভররূপে সৃষ্টি করেছি।", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 5, "globalId": 6028, "arabic": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ", "bengali": "সে কি মনে করে যে, তার উপর কেউ ক্ষমতাবান হবে না ?", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 6, "globalId": 6029, "arabic": "يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا", "bengali": "সে বলেঃ আমি প্রচুর ধন-সম্পদ ব্যয় করেছি।", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 7, "globalId": 6030, "arabic": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ", "bengali": "সে কি মনে করে যে, তাকে কেউ দেখেনি?", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 8, "globalId": 6031, "arabic": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ", "bengali": "আমি কি তাকে দেইনি চক্ষুদ্বয়,", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 9, "globalId": 6032, "arabic": "وَلِسَانًۭا وَشَفَتَيْنِ", "bengali": "জিহবা ও ওষ্ঠদ্বয় ?", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 10, "globalId": 6033, "arabic": "وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ", "bengali": "বস্তুতঃ আমি তাকে দু’টি পথ প্রদর্শন করেছি।", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 11, "globalId": 6034, "arabic": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ", "bengali": "অতঃপর সে ধর্মের ঘাঁটিতে প্রবেশ করেনি।", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 12, "globalId": 6035, "arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ", "bengali": "আপনি জানেন, সে ঘাঁটি কি?", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 13, "globalId": 6036, "arabic": "فَكُّ رَقَبَةٍ", "bengali": "তা হচ্ছে দাসমুক্তি", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 14, "globalId": 6037, "arabic": "أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ", "bengali": "অথবা দুর্ভিক্ষের দিনে অন্নদান।", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 15, "globalId": 6038, "arabic": "يَتِيمًۭا ذَا مَقْرَبَةٍ", "bengali": "এতীম আত্বীয়কে", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 16, "globalId": 6039, "arabic": "أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ", "bengali": "অথবা ধুলি-ধুসরিত মিসকীনকে", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 17, "globalId": 6040, "arabic": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ", "bengali": "অতঃপর তাদের অন্তর্ভুক্ত হওয়া, যারা ঈমান আনে এবং পরস্পরকে উপদেশ দেয় সবরের ও উপদেশ দেয় দয়ার।", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 18, "globalId": 6041, "arabic": "أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ", "bengali": "তারাই সৌভাগ্যশালী।", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 19, "globalId": 6042, "arabic": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ", "bengali": "আর যারা আমার আয়াতসমূহ অস্বীকার করে তারাই হতভাগা।", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}, {"number": 20, "globalId": 6043, "arabic": "عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ", "bengali": "তারা অগ্নিপরিবেষ্টিত অবস্থায় বন্দী থাকবে।", "juz": 30, "manzil": 7, "page": 594, "ruku": 532, "sajda": false}]}