{"number": 78, "metadata": {"number": 78, "nameAr": "سُورَةُ النَّبَإِ", "nameEn": "An-Naba", "nameBn": "আন-নাবা", "meaningEn": "The Announcement", "meaningBn": "মহাসংবাদ", "ayahsCount": 40, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 5673, "endGlobalAyah": 5712}, "ayahs": [{"number": 1, "globalId": 5673, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ", "bengali": "তারা পরস্পরে কি বিষয়ে জিজ্ঞাসাবাদ করছে?", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 2, "globalId": 5674, "arabic": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ", "bengali": "মহা সংবাদ সম্পর্কে,", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 3, "globalId": 5675, "arabic": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ", "bengali": "যে সম্পর্কে তারা মতানৈক্য করে।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 4, "globalId": 5676, "arabic": "كَلَّا سَيَعْلَمُونَ", "bengali": "না, সত্ত্বরই তারা জানতে পারবে,", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 5, "globalId": 5677, "arabic": "ثُمَّ كَلَّا سَيَعْلَمُونَ", "bengali": "অতঃপর না, সত্বর তারা জানতে পারবে।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 6, "globalId": 5678, "arabic": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا", "bengali": "আমি কি করিনি ভূমিকে বিছানা", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 7, "globalId": 5679, "arabic": "وَٱلْجِبَالَ أَوْتَادًۭا", "bengali": "এবং পর্বতমালাকে পেরেক?", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 8, "globalId": 5680, "arabic": "وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا", "bengali": "আমি তোমাদেরকে জোড়া জোড়া সৃষ্টি করেছি,", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 9, "globalId": 5681, "arabic": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا", "bengali": "তোমাদের নিদ্রাকে করেছি ক্লান্তি দূরকারী,", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 10, "globalId": 5682, "arabic": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا", "bengali": "রাত্রিকে করেছি আবরণ।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 11, "globalId": 5683, "arabic": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا", "bengali": "দিনকে করেছি জীবিকা অর্জনের সময়,", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 12, "globalId": 5684, "arabic": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا", "bengali": "নির্মান করেছি তোমাদের মাথার উপর মজবুত সপ্ত-আকাশ।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 13, "globalId": 5685, "arabic": "وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا", "bengali": "এবং একটি উজ্জ্বল প্রদীপ সৃষ্টি করেছি।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 14, "globalId": 5686, "arabic": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا", "bengali": "আমি জলধর মেঘমালা থেকে প্রচুর বৃষ্টিপাত করি,", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 15, "globalId": 5687, "arabic": "لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا", "bengali": "যাতে তদ্দ্বারা উৎপন্ন করি শস্য, উদ্ভিদ।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 16, "globalId": 5688, "arabic": "وَجَنَّٰتٍ أَلْفَافًا", "bengali": "ও পাতাঘন উদ্যান।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 17, "globalId": 5689, "arabic": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا", "bengali": "নিশ্চয় বিচার দিবস নির্ধারিত রয়েছে।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 18, "globalId": 5690, "arabic": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا", "bengali": "যেদিন শিংগায় ফুঁক দেয়া হবে, তখন তোমরা দলে দলে সমাগত হবে।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 19, "globalId": 5691, "arabic": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا", "bengali": "আকাশ বিদীর্ণ হয়ে; তাতে বহু দরজা সৃষ্টি হবে।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 20, "globalId": 5692, "arabic": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا", "bengali": "এবং পর্বতমালা চালিত হয়ে মরীচিকা হয়ে যাবে।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 21, "globalId": 5693, "arabic": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا", "bengali": "নিশ্চয় জাহান্নাম প্রতীক্ষায় থাকবে,", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 22, "globalId": 5694, "arabic": "لِّلطَّٰغِينَ مَـَٔابًۭا", "bengali": "সীমালংঘনকারীদের আশ্রয়স্থলরূপে।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 23, "globalId": 5695, "arabic": "لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا", "bengali": "তারা তথায় শতাব্দীর পর শতাব্দী অবস্থান করবে।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 24, "globalId": 5696, "arabic": "لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا", "bengali": "তথায় তারা কোন শীতল এবং পানীয় আস্বাদন করবে না;", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 25, "globalId": 5697, "arabic": "إِلَّا حَمِيمًۭا وَغَسَّاقًۭا", "bengali": "কিন্তু ফুটন্ত পানি ও পূঁজ পাবে।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 26, "globalId": 5698, "arabic": "جَزَآءًۭ وِفَاقًا", "bengali": "পরিপূর্ণ প্রতিফল হিসেবে।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 27, "globalId": 5699, "arabic": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا", "bengali": "নিশ্চয় তারা হিসাব-নিকাশ আশা করত না।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 28, "globalId": 5700, "arabic": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا", "bengali": "এবং আমার আয়াতসমূহে পুরোপুরি মিথ্যারোপ করত।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 29, "globalId": 5701, "arabic": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا", "bengali": "আমি সবকিছুই লিপিবদ্ধ করে সংরক্ষিত করেছি।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 30, "globalId": 5702, "arabic": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا", "bengali": "অতএব, তোমরা আস্বাদন কর, আমি কেবল তোমাদের শাস্তিই বৃদ্ধি করব।", "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "sajda": false}, {"number": 31, "globalId": 5703, "arabic": "إِنَّ لِلْمُتَّقِينَ مَفَازًا", "bengali": "পরহেযগারদের জন্যে রয়েছে সাফল্য।", "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "sajda": false}, {"number": 32, "globalId": 5704, "arabic": "حَدَآئِقَ وَأَعْنَٰبًۭا", "bengali": "উদ্যান, আঙ্গুর,", "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "sajda": false}, {"number": 33, "globalId": 5705, "arabic": "وَكَوَاعِبَ أَتْرَابًۭا", "bengali": "সমবয়স্কা, পূর্ণযৌবনা তরুণী।", "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "sajda": false}, {"number": 34, "globalId": 5706, "arabic": "وَكَأْسًۭا دِهَاقًۭا", "bengali": "এবং পূর্ণ পানপাত্র।", "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "sajda": false}, {"number": 35, "globalId": 5707, "arabic": "لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا", "bengali": "তারা তথায় অসার ও মিথ্যা বাক্য শুনবে না।", "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "sajda": false}, {"number": 36, "globalId": 5708, "arabic": "جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا", "bengali": "এটা আপনার পালনকর্তার তরফ থেকে যথোচিত দান,", "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "sajda": false}, {"number": 37, "globalId": 5709, "arabic": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا", "bengali": "যিনি নভোমন্ডল, ভূমন্ডল ও এতদুভয়ের মধ্যবর্তী সবকিছুর পালনকর্তা, দয়াময়, কেউ তাঁর সাথে কথার অধিকারী হবে না।", "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "sajda": false}, {"number": 38, "globalId": 5710, "arabic": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا", "bengali": "যেদিন রূহ ও ফেরেশতাগণ সারিবদ্ধভাবে দাঁড়াবে। দয়াময় আল্লাহ যাকে অনুমতি দিবেন, সে ব্যতিত কেউ কথা বলতে পারবে না এবং সে সত্যকথা বলবে।", "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "sajda": false}, {"number": 39, "globalId": 5711, "arabic": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا", "bengali": "এই দিবস সত্য। অতঃপর যার ইচ্ছা, সে তার পালনকর্তার কাছে ঠিকানা তৈরী করুক।", "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "sajda": false}, {"number": 40, "globalId": 5712, "arabic": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا", "bengali": "আমি তোমাদেরকে আসন্ন শাস্তি সম্পর্কে সতর্ক করলাম, যেদিন মানুষ প্রত্যেক্ষ করবে যা সে সামনে প্রেরণ করেছে এবং কাফের বলবেঃ হায়, আফসোস-আমি যদি মাটি হয়ে যেতাম।", "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "sajda": false}]}