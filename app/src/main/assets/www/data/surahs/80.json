{"number": 80, "metadata": {"number": 80, "nameAr": "سُورَةُ عَبَسَ", "nameEn": "Abasa", "nameBn": "আবাসা", "meaningEn": "He frowned", "meaningBn": "তিনি ভ্রুকুটি করলেন", "ayahsCount": 42, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 5759, "endGlobalAyah": 5800}, "ayahs": [{"number": 1, "globalId": 5759, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ", "bengali": "তিনি ভ্রূকুঞ্চিত করলেন এবং মুখ ফিরিয়ে নিলেন।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 2, "globalId": 5760, "arabic": "أَن جَآءَهُ ٱلْأَعْمَىٰ", "bengali": "কারণ, তাঁর কাছে এক অন্ধ আগমন করল।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 3, "globalId": 5761, "arabic": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ", "bengali": "আপনি কি জানেন, সে হয়তো পরিশুদ্ধ হত,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 4, "globalId": 5762, "arabic": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ", "bengali": "অথবা উপদেশ গ্রহণ করতো এবং উপদেশ তার উপকার হত।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 5, "globalId": 5763, "arabic": "أَمَّا مَنِ ٱسْتَغْنَىٰ", "bengali": "পরন্তু যে বেপরোয়া,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 6, "globalId": 5764, "arabic": "فَأَنتَ لَهُۥ تَصَدَّىٰ", "bengali": "আপনি তার চিন্তায় মশগুল।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 7, "globalId": 5765, "arabic": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ", "bengali": "সে শুদ্ধ না হলে আপনার কোন দোষ নেই।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 8, "globalId": 5766, "arabic": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ", "bengali": "যে আপনার কাছে দৌড়ে আসলো", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 9, "globalId": 5767, "arabic": "وَهُوَ يَخْشَىٰ", "bengali": "এমতাবস্থায় যে, সে ভয় করে,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 10, "globalId": 5768, "arabic": "فَأَنتَ عَنْهُ تَلَهَّىٰ", "bengali": "আপনি তাকে অবজ্ঞা করলেন।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 11, "globalId": 5769, "arabic": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ", "bengali": "কখনও এরূপ করবেন না, এটা উপদেশবানী।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 12, "globalId": 5770, "arabic": "فَمَن شَآءَ ذَكَرَهُۥ", "bengali": "অতএব, যে ইচ্ছা করবে, সে একে গ্রহণ করবে।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 13, "globalId": 5771, "arabic": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ", "bengali": "এটা লিখিত আছে সম্মানিত,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 14, "globalId": 5772, "arabic": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ", "bengali": "উচ্চ পবিত্র পত্রসমূহে,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 15, "globalId": 5773, "arabic": "بِأَيْدِى سَفَرَةٍۢ", "bengali": "লিপিকারের হস্তে,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 16, "globalId": 5774, "arabic": "كِرَامٍۭ بَرَرَةٍۢ", "bengali": "যারা মহৎ, পূত চরিত্র।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 17, "globalId": 5775, "arabic": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ", "bengali": "মানুষ ধ্বংস হোক, সে কত অকৃতজ্ঞ!", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 18, "globalId": 5776, "arabic": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ", "bengali": "তিনি তাকে কি বস্তু থেকে সৃষ্টি করেছেন?", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 19, "globalId": 5777, "arabic": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ", "bengali": "শুক্র থেকে তাকে সৃষ্টি করেছেন, অতঃপর তাকে সুপরিমিত করেছেন।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 20, "globalId": 5778, "arabic": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ", "bengali": "অতঃপর তার পথ সহজ করেছেন,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 21, "globalId": 5779, "arabic": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ", "bengali": "অতঃপর তার মৃত্যু ঘটান ও কবরস্থ করেন তাকে।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 22, "globalId": 5780, "arabic": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ", "bengali": "এরপর যখন ইচ্ছা করবেন তখন তাকে পুনরুজ্জীবিত করবেন।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 23, "globalId": 5781, "arabic": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ", "bengali": "সে কখনও কৃতজ্ঞ হয়নি, তিনি তাকে যা আদেশ করেছেন, সে তা পূর্ণ করেনি।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 24, "globalId": 5782, "arabic": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ", "bengali": "মানুষ তার খাদ্যের প্রতি লক্ষ্য করুক,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 25, "globalId": 5783, "arabic": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا", "bengali": "আমি আশ্চর্য উপায়ে পানি বর্ষণ করেছি,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 26, "globalId": 5784, "arabic": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا", "bengali": "এরপর আমি ভূমিকে বিদীর্ণ করেছি,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 27, "globalId": 5785, "arabic": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا", "bengali": "অতঃপর তাতে উৎপন্ন করেছি শস্য,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 28, "globalId": 5786, "arabic": "وَعِنَبًۭا وَقَضْبًۭا", "bengali": "আঙ্গুর, শাক-সব্জি,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 29, "globalId": 5787, "arabic": "وَزَيْتُونًۭا وَنَخْلًۭا", "bengali": "যয়তুন, খর্জূর,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 30, "globalId": 5788, "arabic": "وَحَدَآئِقَ غُلْبًۭا", "bengali": "ঘন উদ্যান,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 31, "globalId": 5789, "arabic": "وَفَٰكِهَةًۭ وَأَبًّۭا", "bengali": "ফল এবং ঘাস", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 32, "globalId": 5790, "arabic": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ", "bengali": "তোমাদেরও তোমাদের চতুস্পদ জন্তুদের উপাকারার্থে।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 33, "globalId": 5791, "arabic": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ", "bengali": "অতঃপর যেদিন কর্ণবিদারক নাদ আসবে,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 34, "globalId": 5792, "arabic": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ", "bengali": "সেদিন পলায়ন করবে মানুষ তার ভ্রাতার কাছ থেকে,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 35, "globalId": 5793, "arabic": "وَأُمِّهِۦ وَأَبِيهِ", "bengali": "তার মাতা, তার পিতা,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 36, "globalId": 5794, "arabic": "وَصَٰحِبَتِهِۦ وَبَنِيهِ", "bengali": "তার পত্নী ও তার সন্তানদের কাছ থেকে।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 37, "globalId": 5795, "arabic": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ", "bengali": "সেদিন প্রত্যেকেরই নিজের এক চিন্তা থাকবে, যা তাকে ব্যতিব্যস্ত করে রাখবে।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 38, "globalId": 5796, "arabic": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ", "bengali": "অনেক মুখমন্ডল সেদিন হবে উজ্জ্বল,", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 39, "globalId": 5797, "arabic": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ", "bengali": "সহাস্য ও প্রফুল্ল।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 40, "globalId": 5798, "arabic": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ", "bengali": "এবং অনেক মুখমন্ডল সেদিন হবে ধুলি ধূসরিত।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 41, "globalId": 5799, "arabic": "تَرْهَقُهَا قَتَرَةٌ", "bengali": "তাদেরকে কালিমা আচ্ছন্ন করে রাখবে।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}, {"number": 42, "globalId": 5800, "arabic": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ", "bengali": "তারাই কাফের পাপিষ্ঠের দল।", "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false}]}