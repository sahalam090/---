{"number": 94, "metadata": {"number": 94, "nameAr": "سُورَةُ الشَّرۡحِ", "nameEn": "Ash-Sharh", "nameBn": "আল-ইনশিরাহ", "meaningEn": "The Consolation", "meaningBn": "বক্ষ প্রশস্তকরণ", "ayahsCount": 8, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 6091, "endGlobalAyah": 6098}, "ayahs": [{"number": 1, "globalId": 6091, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ", "bengali": "আমি কি আপনার বক্ষ উম্মুক্ত করে দেইনি?", "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false}, {"number": 2, "globalId": 6092, "arabic": "وَوَضَعْنَا عَنكَ وِزْرَكَ", "bengali": "আমি লাঘব করেছি আপনার বোঝা,", "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false}, {"number": 3, "globalId": 6093, "arabic": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ", "bengali": "যা ছিল আপনার জন্যে অতিশয় দুঃসহ।", "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false}, {"number": 4, "globalId": 6094, "arabic": "وَرَفَعْنَا لَكَ ذِكْرَكَ", "bengali": "আমি আপনার আলোচনাকে সমুচ্চ করেছি।", "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false}, {"number": 5, "globalId": 6095, "arabic": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا", "bengali": "নিশ্চয় কষ্টের সাথে স্বস্তি রয়েছে।", "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false}, {"number": 6, "globalId": 6096, "arabic": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا", "bengali": "নিশ্চয় কষ্টের সাথে স্বস্তি রয়েছে।", "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false}, {"number": 7, "globalId": 6097, "arabic": "فَإِذَا فَرَغْتَ فَٱنصَبْ", "bengali": "অতএব, যখন অবসর পান পরিশ্রম করুন।", "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false}, {"number": 8, "globalId": 6098, "arabic": "وَإِلَىٰ رَبِّكَ فَٱرْغَب", "bengali": "এবং আপনার পালনকর্তার প্রতি মনোনিবেশ করুন।", "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false}]}