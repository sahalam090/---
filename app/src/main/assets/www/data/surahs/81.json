{"number": 81, "metadata": {"number": 81, "nameAr": "سُورَةُ التَّكۡوِيرِ", "nameEn": "At-Takwir", "nameBn": "আত-তাকবীর", "meaningEn": "The Overthrowing", "meaningBn": "অন্ধকারাচ্ছন্ন", "ayahsCount": 29, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 5801, "endGlobalAyah": 5829}, "ayahs": [{"number": 1, "globalId": 5801, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ", "bengali": "যখন সূর্য আলোহীন হয়ে যাবে,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 2, "globalId": 5802, "arabic": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ", "bengali": "যখন নক্ষত্র মলিন হয়ে যাবে,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 3, "globalId": 5803, "arabic": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ", "bengali": "যখন পর্বতমালা অপসারিত হবে,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 4, "globalId": 5804, "arabic": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ", "bengali": "যখন দশ মাসের গর্ভবতী উষ্ট্রীসমূহ উপেক্ষিত হবে;", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 5, "globalId": 5805, "arabic": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ", "bengali": "যখন বন্য পশুরা একত্রিত হয়ে যাবে,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 6, "globalId": 5806, "arabic": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ", "bengali": "যখন সমুদ্রকে উত্তাল করে তোলা হবে,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 7, "globalId": 5807, "arabic": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ", "bengali": "যখন আত্মাসমূহকে যুগল করা হবে,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 8, "globalId": 5808, "arabic": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ", "bengali": "যখন জীবন্ত প্রোথিত কন্যাকে জিজ্ঞেস করা হবে,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 9, "globalId": 5809, "arabic": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ", "bengali": "কি অপরাধে তাকে হত্য করা হল?", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 10, "globalId": 5810, "arabic": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ", "bengali": "যখন আমলনামা খোলা হবে,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 11, "globalId": 5811, "arabic": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ", "bengali": "যখন আকাশের আবরণ অপসারিত হবে,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 12, "globalId": 5812, "arabic": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ", "bengali": "যখন জাহান্নামের অগ্নি প্রজ্বলিত করা হবে", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 13, "globalId": 5813, "arabic": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ", "bengali": "এবং যখন জান্নাত সন্নিকটবর্তী হবে,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 14, "globalId": 5814, "arabic": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ", "bengali": "তখন প্রত্যেকেই জেনে নিবে সে কি উপস্থিত করেছে।", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 15, "globalId": 5815, "arabic": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ", "bengali": "আমি শপথ করি যেসব নক্ষত্রগুলো পশ্চাতে সরে যায়।", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 16, "globalId": 5816, "arabic": "ٱلْجَوَارِ ٱلْكُنَّسِ", "bengali": "চলমান হয় ও অদৃশ্য হয়,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 17, "globalId": 5817, "arabic": "وَٱلَّيْلِ إِذَا عَسْعَسَ", "bengali": "শপথ নিশাবসান ও", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 18, "globalId": 5818, "arabic": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ", "bengali": "প্রভাত আগমন কালের,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 19, "globalId": 5819, "arabic": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ", "bengali": "নিশ্চয় কোরআন সম্মানিত রসূলের আনীত বাণী,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 20, "globalId": 5820, "arabic": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ", "bengali": "যিনি শক্তিশালী, আরশের মালিকের নিকট মর্যাদাশালী,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 21, "globalId": 5821, "arabic": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ", "bengali": "সবার মান্যবর, সেখানকার বিশ্বাসভাজন।", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 22, "globalId": 5822, "arabic": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ", "bengali": "এবং তোমাদের সাথী পাগল নন।", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 23, "globalId": 5823, "arabic": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ", "bengali": "তিনি সেই ফেরেশতাকে প্রকাশ্য দিগন্তে দেখেছেন।", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 24, "globalId": 5824, "arabic": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ", "bengali": "তিনি অদৃশ্য বিষয় বলতে কৃপনতা করেন না।", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 25, "globalId": 5825, "arabic": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ", "bengali": "এটা বিতাড়িত শয়তানের উক্তি নয়।", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 26, "globalId": 5826, "arabic": "فَأَيْنَ تَذْهَبُونَ", "bengali": "অতএব, তোমরা কোথায় যাচ্ছ?", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 27, "globalId": 5827, "arabic": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ", "bengali": "এটা তো কেবল বিশ্বাবাসীদের জন্যে উপদেশ,", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 28, "globalId": 5828, "arabic": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ", "bengali": "তার জন্যে, যে তোমাদের মধ্যে সোজা চলতে চায়।", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}, {"number": 29, "globalId": 5829, "arabic": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ", "bengali": "তোমরা আল্লাহ রাব্বুল আলামীনের অভিপ্রায়ের বাইরে অন্য কিছুই ইচ্ছা করতে পার না।", "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false}]}