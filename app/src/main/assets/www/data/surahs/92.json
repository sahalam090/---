{"number": 92, "metadata": {"number": 92, "nameAr": "سُورَةُ اللَّيۡلِ", "nameEn": "Al-Lail", "nameBn": "আল-লাইল", "meaningEn": "The Night", "meaningBn": "রাত", "ayahsCount": 21, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 6059, "endGlobalAyah": 6079}, "ayahs": [{"number": 1, "globalId": 6059, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ", "bengali": "শপথ রাত্রির, যখন সে আচ্ছন্ন করে,", "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false}, {"number": 2, "globalId": 6060, "arabic": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ", "bengali": "শপথ দিনের, যখন সে আলোকিত হয়", "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false}, {"number": 3, "globalId": 6061, "arabic": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "bengali": "এবং তাঁর, যিনি নর ও নারী সৃষ্টি করেছেন,", "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false}, {"number": 4, "globalId": 6062, "arabic": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ", "bengali": "নিশ্চয় তোমাদের কর্ম প্রচেষ্টা বিভিন্ন ধরনের।", "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false}, {"number": 5, "globalId": 6063, "arabic": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ", "bengali": "অতএব, যে দান করে এবং খোদাভীরু হয়,", "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false}, {"number": 6, "globalId": 6064, "arabic": "وَصَدَّقَ بِٱلْحُسْنَىٰ", "bengali": "এবং উত্তম বিষয়কে সত্য মনে করে,", "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false}, {"number": 7, "globalId": 6065, "arabic": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ", "bengali": "আমি তাকে সুখের বিষয়ের জন্যে সহজ পথ দান করব।", "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false}, {"number": 8, "globalId": 6066, "arabic": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ", "bengali": "আর যে কৃপণতা করে ও বেপরওয়া হয়", "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false}, {"number": 9, "globalId": 6067, "arabic": "وَكَذَّبَ بِٱلْحُسْنَىٰ", "bengali": "এবং উত্তম বিষয়কে মিথ্যা মনে করে,", "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false}, {"number": 10, "globalId": 6068, "arabic": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ", "bengali": "আমি তাকে কষ্টের বিষয়ের জন্যে সহজ পথ দান করব।", "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false}, {"number": 11, "globalId": 6069, "arabic": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ", "bengali": "যখন সে অধঃপতিত হবে, তখন তার সম্পদ তার কোনই কাজে আসবে না।", "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false}, {"number": 12, "globalId": 6070, "arabic": "إِنَّ عَلَيْنَا لَلْهُدَىٰ", "bengali": "আমার দায়িত্ব পথ প্রদর্শন করা।", "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false}, {"number": 13, "globalId": 6071, "arabic": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ", "bengali": "আর আমি মালিক ইহকালের ও পরকালের।", "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false}, {"number": 14, "globalId": 6072, "arabic": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ", "bengali": "অতএব, আমি তোমাদেরকে প্রজ্বলিত অগ্নি সম্পর্কে সতর্ক করে দিয়েছি।", "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false}, {"number": 15, "globalId": 6073, "arabic": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى", "bengali": "এতে নিতান্ত হতভাগ্য ব্যক্তিই প্রবেশ করবে,", "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "sajda": false}, {"number": 16, "globalId": 6074, "arabic": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ", "bengali": "যে মিথ্যারোপ করে ও মুখ ফিরিয়ে নেয়।", "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "sajda": false}, {"number": 17, "globalId": 6075, "arabic": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى", "bengali": "এ থেকে দূরে রাখা হবে খোদাভীরু ব্যক্তিকে,", "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "sajda": false}, {"number": 18, "globalId": 6076, "arabic": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ", "bengali": "যে আত্নশুদ্ধির জন্যে তার ধন-সম্পদ দান করে।", "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "sajda": false}, {"number": 19, "globalId": 6077, "arabic": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ", "bengali": "এবং তার উপর কারও কোন প্রতিদানযোগ্য অনুগ্রহ থাকে না।", "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "sajda": false}, {"number": 20, "globalId": 6078, "arabic": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ", "bengali": "তার মহান পালনকর্তার সন্তুষ্টি অন্বেষণ ব্যতীত।", "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "sajda": false}, {"number": 21, "globalId": 6079, "arabic": "وَلَسَوْفَ يَرْضَىٰ", "bengali": "সে সত্বরই সন্তুষ্টি লাভ করবে।", "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "sajda": false}]}