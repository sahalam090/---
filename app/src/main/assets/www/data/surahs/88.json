{"number": 88, "metadata": {"number": 88, "nameAr": "سُورَةُ الغَاشِيَةِ", "nameEn": "Al-Ghaashiya", "nameBn": "আল-গাশিয়াহ", "meaningEn": "The Overwhelming", "meaningBn": "আচ্ছন্নকারী ঘটনা", "ayahsCount": 26, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 5968, "endGlobalAyah": 5993}, "ayahs": [{"number": 1, "globalId": 5968, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ", "bengali": "আপনার কাছে আচ্ছন্নকারী কেয়ামতের বৃত্তান্ত পৌঁছেছে কি?", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 2, "globalId": 5969, "arabic": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ", "bengali": "অনেক মুখমন্ডল সেদিন হবে লাঞ্ছিত,", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 3, "globalId": 5970, "arabic": "عَامِلَةٌۭ نَّاصِبَةٌۭ", "bengali": "ক্লিষ্ট, ক্লান্ত।", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 4, "globalId": 5971, "arabic": "تَصْلَىٰ نَارًا حَامِيَةًۭ", "bengali": "তারা জ্বলন্ত আগুনে পতিত হবে।", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 5, "globalId": 5972, "arabic": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ", "bengali": "তাদেরকে ফুটন্ত নহর থেকে পান করানো হবে।", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 6, "globalId": 5973, "arabic": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ", "bengali": "কন্টকপূর্ণ ঝাড় ব্যতীত তাদের জন্যে কোন খাদ্য নেই।", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 7, "globalId": 5974, "arabic": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ", "bengali": "এটা তাদেরকে পুষ্ট করবে না এবং ক্ষুধায়ও উপকার করবে না।", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 8, "globalId": 5975, "arabic": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ", "bengali": "অনেক মুখমন্ডল সেদিন হবে, সজীব,", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 9, "globalId": 5976, "arabic": "لِّسَعْيِهَا رَاضِيَةٌۭ", "bengali": "তাদের কর্মের কারণে সন্তুষ্ট।", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 10, "globalId": 5977, "arabic": "فِى جَنَّةٍ عَالِيَةٍۢ", "bengali": "তারা থাকবে, সুউচ্চ জান্নাতে।", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 11, "globalId": 5978, "arabic": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ", "bengali": "তথায় শুনবে না কোন অসার কথাবার্তা।", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 12, "globalId": 5979, "arabic": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ", "bengali": "তথায় থাকবে প্রবাহিত ঝরণা।", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 13, "globalId": 5980, "arabic": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ", "bengali": "তথায় থাকবে উন্নত সুসজ্জিত আসন।", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 14, "globalId": 5981, "arabic": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ", "bengali": "এবং সংরক্ষিত পানপাত্র", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 15, "globalId": 5982, "arabic": "وَنَمَارِقُ مَصْفُوفَةٌۭ", "bengali": "এবং সারি সারি গালিচা", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 16, "globalId": 5983, "arabic": "وَزَرَابِىُّ مَبْثُوثَةٌ", "bengali": "এবং বিস্তৃত বিছানো কার্পেট।", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 17, "globalId": 5984, "arabic": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ", "bengali": "তারা কি উষ্ট্রের প্রতি লক্ষ্য করে না যে, তা কিভাবে সৃষ্টি করা হয়েছে?", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 18, "globalId": 5985, "arabic": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ", "bengali": "এবং আকাশের প্রতি লক্ষ্য করে না যে, তা কিভাবে উচ্চ করা হয়েছে?", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 19, "globalId": 5986, "arabic": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ", "bengali": "এবং পাহাড়ের দিকে যে, তা কিভাবে স্থাপন করা হয়েছে?", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 20, "globalId": 5987, "arabic": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ", "bengali": "এবং পৃথিবীর দিকে যে, তা কিভাবে সমতল বিছানো হয়েছে?", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 21, "globalId": 5988, "arabic": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ", "bengali": "অতএব, আপনি উপদেশ দিন, আপনি তো কেবল একজন উপদেশদাতা,", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 22, "globalId": 5989, "arabic": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ", "bengali": "আপনি তাদের শাসক নন,", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 23, "globalId": 5990, "arabic": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ", "bengali": "কিন্তু যে মুখ ফিরিয়ে নেয় ও কাফের হয়ে যায়,", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 24, "globalId": 5991, "arabic": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ", "bengali": "আল্লাহ তাকে মহা আযাব দেবেন।", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 25, "globalId": 5992, "arabic": "إِنَّ إِلَيْنَآ إِيَابَهُمْ", "bengali": "নিশ্চয় তাদের প্রত্যাবর্তন আমারই নিকট,", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}, {"number": 26, "globalId": 5993, "arabic": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم", "bengali": "অতঃপর তাদের হিসাব-নিকাশ আমারই দায়িত্ব।", "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false}]}