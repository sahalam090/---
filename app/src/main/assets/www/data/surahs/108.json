{"number": 108, "metadata": {"number": 108, "nameAr": "سُورَةُ الكَوۡثَرِ", "nameEn": "Al-Kawthar", "nameBn": "আল-কাউসার", "meaningEn": "Abundance", "meaningBn": "প্রাচুর্য", "ayahsCount": 3, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 6205, "endGlobalAyah": 6207}, "ayahs": [{"number": 1, "globalId": 6205, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ", "bengali": "নিশ্চয় আমি আপনাকে কাওসার দান করেছি।", "juz": 30, "manzil": 7, "page": 602, "ruku": 550, "sajda": false}, {"number": 2, "globalId": 6206, "arabic": "فَصَلِّ لِرَبِّكَ وَٱنْحَرْ", "bengali": "অতএব আপনার পালনকর্তার উদ্দেশ্যে নামায পড়ুন এবং কোরবানী করুন।", "juz": 30, "manzil": 7, "page": 602, "ruku": 550, "sajda": false}, {"number": 3, "globalId": 6207, "arabic": "إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ", "bengali": "যে আপনার শত্রু, সেই তো লেজকাটা, নির্বংশ।", "juz": 30, "manzil": 7, "page": 602, "ruku": 550, "sajda": false}]}