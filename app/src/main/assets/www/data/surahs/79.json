{"number": 79, "metadata": {"number": 79, "nameAr": "سُورَةُ النَّازِعَاتِ", "nameEn": "An-Naazi'aat", "nameBn": "আন-নাযিআত", "meaningEn": "Those who drag forth", "meaningBn": "উৎপাটনকারী", "ayahsCount": 46, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 5713, "endGlobalAyah": 5758}, "ayahs": [{"number": 1, "globalId": 5713, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًۭا", "bengali": "শপথ সেই ফেরেশতাগণের, যারা ডুব দিয়ে আত্মা উৎপাটন করে,", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 2, "globalId": 5714, "arabic": "وَٱلنَّٰشِطَٰتِ نَشْطًۭا", "bengali": "শপথ তাদের, যারা আত্মার বাঁধন খুলে দেয় মৃদুভাবে;", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 3, "globalId": 5715, "arabic": "وَٱلسَّٰبِحَٰتِ سَبْحًۭا", "bengali": "শপথ তাদের, যারা সন্তরণ করে দ্রুতগতিতে,", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 4, "globalId": 5716, "arabic": "فَٱلسَّٰبِقَٰتِ سَبْقًۭا", "bengali": "শপথ তাদের, যারা দ্রুতগতিতে অগ্রসর হয় এবং", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 5, "globalId": 5717, "arabic": "فَٱلْمُدَبِّرَٰتِ أَمْرًۭا", "bengali": "শপথ তাদের, যারা সকল কর্মনির্বাহ করে, কেয়ামত অবশ্যই হবে।", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 6, "globalId": 5718, "arabic": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ", "bengali": "যেদিন প্রকম্পিত করবে প্রকম্পিতকারী,", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 7, "globalId": 5719, "arabic": "تَتْبَعُهَا ٱلرَّادِفَةُ", "bengali": "অতঃপর পশ্চাতে আসবে পশ্চাদগামী;", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 8, "globalId": 5720, "arabic": "قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ", "bengali": "সেদিন অনেক হৃদয় ভীত-বিহবল হবে।", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 9, "globalId": 5721, "arabic": "أَبْصَٰرُهَا خَٰشِعَةٌۭ", "bengali": "তাদের দৃষ্টি নত হবে।", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 10, "globalId": 5722, "arabic": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ", "bengali": "তারা বলেঃ আমরা কি উলটো পায়ে প্রত্যাবর্তিত হবই-", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 11, "globalId": 5723, "arabic": "أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ", "bengali": "গলিত অস্থি হয়ে যাওয়ার পরও?", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 12, "globalId": 5724, "arabic": "قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ", "bengali": "তবে তো এ প্রত্যাবর্তন সর্বনাশা হবে!", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 13, "globalId": 5725, "arabic": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ", "bengali": "অতএব, এটা তো কেবল এক মহা-নাদ,", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 14, "globalId": 5726, "arabic": "فَإِذَا هُم بِٱلسَّاهِرَةِ", "bengali": "তখনই তারা ময়দানে আবির্ভূত হবে।", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 15, "globalId": 5727, "arabic": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ", "bengali": "মূসার বৃত্তান্ত আপনার কাছে পৌছেছে কি?", "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "sajda": false}, {"number": 16, "globalId": 5728, "arabic": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى", "bengali": "যখন তার পালনকর্তা তাকে পবিত্র তুয়া উপ্যকায় আহবান করেছিলেন,", "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "sajda": false}, {"number": 17, "globalId": 5729, "arabic": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ", "bengali": "ফেরাউনের কাছে যাও, নিশ্চয় সে সীমালংঘন করেছে।", "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "sajda": false}, {"number": 18, "globalId": 5730, "arabic": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ", "bengali": "অতঃপর বলঃ তোমার পবিত্র হওয়ার আগ্রহ আছে কি?", "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "sajda": false}, {"number": 19, "globalId": 5731, "arabic": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ", "bengali": "আমি তোমাকে তোমার পালনকর্তার দিকে পথ দেখাব, যাতে তুমি তাকে ভয় কর।", "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "sajda": false}, {"number": 20, "globalId": 5732, "arabic": "فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ", "bengali": "অতঃপর সে তাকে মহা-নিদর্শন দেখাল।", "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "sajda": false}, {"number": 21, "globalId": 5733, "arabic": "فَكَذَّبَ وَعَصَىٰ", "bengali": "কিন্তু সে মিথ্যারোপ করল এবং অমান্য করল।", "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "sajda": false}, {"number": 22, "globalId": 5734, "arabic": "ثُمَّ أَدْبَرَ يَسْعَىٰ", "bengali": "অতঃপর সে প্রতিকার চেষ্টায় প্রস্থান করল।", "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "sajda": false}, {"number": 23, "globalId": 5735, "arabic": "فَحَشَرَ فَنَادَىٰ", "bengali": "সে সকলকে সমবেত করল এবং সজোরে আহবান করল,", "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "sajda": false}, {"number": 24, "globalId": 5736, "arabic": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ", "bengali": "এবং বললঃ আমিই তোমাদের সেরা পালনকর্তা।", "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "sajda": false}, {"number": 25, "globalId": 5737, "arabic": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ", "bengali": "অতঃপর আল্লাহ তাকে পরকালের ও ইহকালের শাস্তি দিলেন।", "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "sajda": false}, {"number": 26, "globalId": 5738, "arabic": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ", "bengali": "যে ভয় করে তার জন্যে অবশ্যই এতে শিক্ষা রয়েছে।", "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "sajda": false}, {"number": 27, "globalId": 5739, "arabic": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا", "bengali": "তোমাদের সৃষ্টি অধিক কঠিন না আকাশের, যা তিনি নির্মাণ করেছেন?", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 28, "globalId": 5740, "arabic": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا", "bengali": "তিনি একে উচ্চ করেছেন ও সুবিন্যস্ত করেছেন।", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 29, "globalId": 5741, "arabic": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا", "bengali": "তিনি এর রাত্রিকে করেছেন অন্ধকারাচ্ছন্ন এবং এর সূর্যোলোক প্রকাশ করেছেন।", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 30, "globalId": 5742, "arabic": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ", "bengali": "পৃথিবীকে এর পরে বিস্তৃত করেছেন।", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 31, "globalId": 5743, "arabic": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا", "bengali": "তিনি এর মধ্য থেকে এর পানি ও ঘাম নির্গত করেছেন,", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 32, "globalId": 5744, "arabic": "وَٱلْجِبَالَ أَرْسَىٰهَا", "bengali": "পর্বতকে তিনি দৃঢ়ভাবে প্রতিষ্ঠিত করেছেন,", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 33, "globalId": 5745, "arabic": "مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ", "bengali": "তোমাদের ও তোমাদের চতুস্পদ জন্তুদের উপকারার্থে।", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 34, "globalId": 5746, "arabic": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ", "bengali": "অতঃপর যখন মহাসংকট এসে যাবে।", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 35, "globalId": 5747, "arabic": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ", "bengali": "অর্থাৎ যেদিন মানুষ তার কৃতকর্ম স্মরণ করবে", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 36, "globalId": 5748, "arabic": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ", "bengali": "এবং দর্শকদের জন্যে জাহান্নাম প্রকাশ করা হবে,", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 37, "globalId": 5749, "arabic": "فَأَمَّا مَن طَغَىٰ", "bengali": "তখন যে ব্যক্তি সীমালংঘন করেছে;", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 38, "globalId": 5750, "arabic": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا", "bengali": "এবং পার্থিব জীবনকে অগ্রাধিকার দিয়েছে,", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 39, "globalId": 5751, "arabic": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ", "bengali": "তার ঠিকানা হবে জাহান্নাম।", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 40, "globalId": 5752, "arabic": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ", "bengali": "পক্ষান্তরে যে ব্যক্তি তার পালনকর্তার সামনে দন্ডায়মান হওয়াকে ভয় করেছে এবং খেয়াল-খুশী থেকে নিজেকে নিবৃত্ত রেখেছে,", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 41, "globalId": 5753, "arabic": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ", "bengali": "তার ঠিকানা হবে জান্নাত।", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 42, "globalId": 5754, "arabic": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا", "bengali": "তারা আপনাকে জিজ্ঞাসা করে, কেয়ামত কখন হবে?", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 43, "globalId": 5755, "arabic": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ", "bengali": "এর বর্ণনার সাথে আপনার কি সম্পর্ক ?", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 44, "globalId": 5756, "arabic": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ", "bengali": "এর চরম জ্ঞান আপনার পালনকর্তার কাছে।", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 45, "globalId": 5757, "arabic": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا", "bengali": "যে একে ভয় করে, আপনি তো কেবল তাকেই সতর্ক করবেন।", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}, {"number": 46, "globalId": 5758, "arabic": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا", "bengali": "যেদিন তারা একে দেখবে, সেদিন মনে হবে যেন তারা দুনিয়াতে মাত্র এক সন্ধ্যা অথবা এক সকাল অবস্থান করেছে।", "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "sajda": false}]}