{"number": 87, "metadata": {"number": 87, "nameAr": "سُورَةُ الأَعۡلَىٰ", "nameEn": "Al-A'laa", "nameBn": "আল-আলা", "meaningEn": "The Most High", "meaningBn": "সর্বোচ্চ", "ayahsCount": 19, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 5949, "endGlobalAyah": 5967}, "ayahs": [{"number": 1, "globalId": 5949, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى", "bengali": "আপনি আপনার মহান পালনকর্তার নামের পবিত্রতা বর্ণনা করুন", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 2, "globalId": 5950, "arabic": "ٱلَّذِى خَلَقَ فَسَوَّىٰ", "bengali": "যিনি সৃষ্টি করেছেন ও সুবিন্যস্ত করেছেন।", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 3, "globalId": 5951, "arabic": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ", "bengali": "এবং যিনি সুপরিমিত করেছেন ও পথ প্রদর্শন করেছেন", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 4, "globalId": 5952, "arabic": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ", "bengali": "এবং যিনি তৃণাদি উৎপন্ন করেছেন,", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 5, "globalId": 5953, "arabic": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ", "bengali": "অতঃপর করেছেন তাকে কাল আবর্জনা।", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 6, "globalId": 5954, "arabic": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ", "bengali": "আমি আপনাকে পাঠ করাতে থাকব, ফলে আপনি বিস্মৃত হবেন না", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 7, "globalId": 5955, "arabic": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ", "bengali": "আল্লাহ যা ইচ্ছা করেন তা ব্যতীত। নিশ্চয় তিনি জানেন প্রকাশ্য ও গোপন বিষয়।", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 8, "globalId": 5956, "arabic": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ", "bengali": "আমি আপনার জন্যে সহজ শরীয়ত সহজতর করে দেবো।", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 9, "globalId": 5957, "arabic": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ", "bengali": "উপদেশ ফলপ্রসূ হলে উপদেশ দান করুন,", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 10, "globalId": 5958, "arabic": "سَيَذَّكَّرُ مَن يَخْشَىٰ", "bengali": "যে ভয় করে, সে উপদেশ গ্রহণ করবে,", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 11, "globalId": 5959, "arabic": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى", "bengali": "আর যে, হতভাগা, সে তা উপেক্ষা করবে,", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 12, "globalId": 5960, "arabic": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ", "bengali": "সে মহা-অগ্নিতে প্রবেশ করবে।", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 13, "globalId": 5961, "arabic": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ", "bengali": "অতঃপর সেখানে সে মরবেও না, জীবিতও থাকবে না।", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 14, "globalId": 5962, "arabic": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ", "bengali": "নিশ্চয় সাফল্য লাভ করবে সে, যে শুদ্ধ হয়", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 15, "globalId": 5963, "arabic": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ", "bengali": "এবং তার পালনকর্তার নাম স্মরণ করে, অতঃপর নামায আদায় করে।", "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false}, {"number": 16, "globalId": 5964, "arabic": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا", "bengali": "বস্তুতঃ তোমরা পার্থিব জীবনকে অগ্রাধিকার দাও,", "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "sajda": false}, {"number": 17, "globalId": 5965, "arabic": "وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ", "bengali": "অথচ পরকালের জীবন উৎকৃষ্ট ও স্থায়ী।", "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "sajda": false}, {"number": 18, "globalId": 5966, "arabic": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ", "bengali": "এটা লিখিত রয়েছে পূর্ববতী কিতাবসমূহে;", "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "sajda": false}, {"number": 19, "globalId": 5967, "arabic": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ", "bengali": "ইব্রাহীম ও মূসার কিতাবসমূহে।", "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "sajda": false}]}