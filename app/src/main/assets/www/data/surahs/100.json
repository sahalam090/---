{"number": 100, "metadata": {"number": 100, "nameAr": "سُورَةُ العَادِيَاتِ", "nameEn": "Al-Aadiyaat", "nameBn": "আল-আদিয়াত", "meaningEn": "The Chargers", "meaningBn": "অভিযানকারী অশ্ব", "ayahsCount": 11, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 6147, "endGlobalAyah": 6157}, "ayahs": [{"number": 1, "globalId": 6147, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا", "bengali": "শপথ উর্ধ্বশ্বাসে চলমান অশ্বসমূহের,", "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false}, {"number": 2, "globalId": 6148, "arabic": "فَٱلْمُورِيَٰتِ قَدْحًۭا", "bengali": "অতঃপর ক্ষুরাঘাতে অগ্নিবিচ্ছুরক অশ্বসমূহের", "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false}, {"number": 3, "globalId": 6149, "arabic": "فَٱلْمُغِيرَٰتِ صُبْحًۭا", "bengali": "অতঃপর প্রভাতকালে আক্রমণকারী অশ্বসমূহের", "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false}, {"number": 4, "globalId": 6150, "arabic": "فَأَثَرْنَ بِهِۦ نَقْعًۭا", "bengali": "ও যারা সে সময়ে ধুলি উৎক্ষিপ্ত করে", "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false}, {"number": 5, "globalId": 6151, "arabic": "فَوَسَطْنَ بِهِۦ جَمْعًا", "bengali": "অতঃপর যারা শক্রদলের অভ্যন্তরে ঢুকে পড়ে-", "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false}, {"number": 6, "globalId": 6152, "arabic": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ", "bengali": "নিশ্চয় মানুষ তার পালনকর্তার প্রতি অকৃতজ্ঞ।", "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false}, {"number": 7, "globalId": 6153, "arabic": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ", "bengali": "এবং সে অবশ্য এ বিষয়ে অবহিত", "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false}, {"number": 8, "globalId": 6154, "arabic": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ", "bengali": "এবং সে নিশ্চিতই ধন-সম্পদের ভালবাসায় মত্ত।", "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false}, {"number": 9, "globalId": 6155, "arabic": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ", "bengali": "সে কি জানে না, যখন কবরে যা আছে, তা উত্থিত হবে", "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false}, {"number": 10, "globalId": 6156, "arabic": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ", "bengali": "এবং অন্তরে যা আছে, তা অর্জন করা হবে?", "juz": 30, "manzil": 7, "page": 600, "ruku": 542, "sajda": false}, {"number": 11, "globalId": 6157, "arabic": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ", "bengali": "সেদিন তাদের কি হবে, সে সম্পর্কে তাদের পালনকর্তা সবিশেষ জ্ঞাত।", "juz": 30, "manzil": 7, "page": 600, "ruku": 542, "sajda": false}]}