{"number": 74, "metadata": {"number": 74, "nameAr": "سُورَةُ المُدَّثِّرِ", "nameEn": "Al-Muddaththir", "nameBn": "আল-মুদ্দাসসির", "meaningEn": "The Cloaked One", "meaningBn": "চাদরাবৃত", "ayahsCount": 56, "revelationType": "মক্কী", "revelationEn": "Meccan", "startGlobalAyah": 5496, "endGlobalAyah": 5551}, "ayahs": [{"number": 1, "globalId": 5496, "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ يَٰٓأَيُّهَا ٱلْمُدَّثِّرُ", "bengali": "হে চাদরাবৃত!", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 2, "globalId": 5497, "arabic": "قُمْ فَأَنذِرْ", "bengali": "উঠুন, সতর্ক করুন,", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 3, "globalId": 5498, "arabic": "وَرَبَّكَ فَكَبِّرْ", "bengali": "আপন পালনকর্তার মাহাত্ম্য ঘোষনা করুন,", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 4, "globalId": 5499, "arabic": "وَثِيَابَكَ فَطَهِّرْ", "bengali": "আপন পোশাক পবিত্র করুন", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 5, "globalId": 5500, "arabic": "وَٱلرُّجْزَ فَٱهْجُرْ", "bengali": "এবং অপবিত্রতা থেকে দূরে থাকুন।", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 6, "globalId": 5501, "arabic": "وَلَا تَمْنُن تَسْتَكْثِرُ", "bengali": "অধিক প্রতিদানের আশায় অন্যকে কিছু দিবেন না।", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 7, "globalId": 5502, "arabic": "وَلِرَبِّكَ فَٱصْبِرْ", "bengali": "এবং আপনার পালনকর্তার উদ্দেশে সবর করুন।", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 8, "globalId": 5503, "arabic": "فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ", "bengali": "যেদিন শিংগায় ফুঁক দেয়া হবে;", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 9, "globalId": 5504, "arabic": "فَذَٰلِكَ يَوْمَئِذٍۢ يَوْمٌ عَسِيرٌ", "bengali": "সেদিন হবে কঠিন দিন,", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 10, "globalId": 5505, "arabic": "عَلَى ٱلْكَٰفِرِينَ غَيْرُ يَسِيرٍۢ", "bengali": "কাফেরদের জন্যে এটা সহজ নয়।", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 11, "globalId": 5506, "arabic": "ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًۭا", "bengali": "যাকে আমি অনন্য করে সৃষ্টি করেছি, তাকে আমার হাতে ছেড়ে দিন।", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 12, "globalId": 5507, "arabic": "وَجَعَلْتُ لَهُۥ مَالًۭا مَّمْدُودًۭا", "bengali": "আমি তাকে বিপুল ধন-সম্পদ দিয়েছি।", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 13, "globalId": 5508, "arabic": "وَبَنِينَ شُهُودًۭا", "bengali": "এবং সদা সংগী পুত্রবর্গ দিয়েছি,", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 14, "globalId": 5509, "arabic": "وَمَهَّدتُّ لَهُۥ تَمْهِيدًۭا", "bengali": "এবং তাকে খুব সচ্ছলতা দিয়েছি।", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 15, "globalId": 5510, "arabic": "ثُمَّ يَطْمَعُ أَنْ أَزِيدَ", "bengali": "এরপরও সে আশা করে যে, আমি তাকে আরও বেশী দেই।", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 16, "globalId": 5511, "arabic": "كَلَّآ ۖ إِنَّهُۥ كَانَ لِءَايَٰتِنَا عَنِيدًۭا", "bengali": "কখনই নয়! সে আমার নিদর্শনসমূহের বিরুদ্ধাচরণকারী।", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 17, "globalId": 5512, "arabic": "سَأُرْهِقُهُۥ صَعُودًا", "bengali": "আমি সত্ত্বরই তাকে শাস্তির পাহাড়ে আরোহণ করাব।", "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "sajda": false}, {"number": 18, "globalId": 5513, "arabic": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ", "bengali": "সে চিন্তা করেছে এবং মনঃস্থির করেছে,", "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "sajda": false}, {"number": 19, "globalId": 5514, "arabic": "فَقُتِلَ كَيْفَ قَدَّرَ", "bengali": "ধ্বংস হোক সে, কিরূপে সে মনঃস্থির করেছে!", "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "sajda": false}, {"number": 20, "globalId": 5515, "arabic": "ثُمَّ قُتِلَ كَيْفَ قَدَّرَ", "bengali": "আবার ধ্বংস হোক সে, কিরূপে সে মনঃস্থির করেছে!", "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "sajda": false}, {"number": 21, "globalId": 5516, "arabic": "ثُمَّ نَظَرَ", "bengali": "সে আবার দৃষ্টিপাত করেছে,", "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "sajda": false}, {"number": 22, "globalId": 5517, "arabic": "ثُمَّ عَبَسَ وَبَسَرَ", "bengali": "অতঃপর সে ভ্রূকুঞ্চিত করেছে ও মুখ বিকৃত করেছে,", "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "sajda": false}, {"number": 23, "globalId": 5518, "arabic": "ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ", "bengali": "অতঃপর পৃষ্ঠপ্রদশন করেছে ও অহংকার করেছে।", "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "sajda": false}, {"number": 24, "globalId": 5519, "arabic": "فَقَالَ إِنْ هَٰذَآ إِلَّا سِحْرٌۭ يُؤْثَرُ", "bengali": "এরপর বলেছেঃ এতো লোক পরস্পরায় প্রাপ্ত জাদু বৈ নয়,", "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "sajda": false}, {"number": 25, "globalId": 5520, "arabic": "إِنْ هَٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ", "bengali": "এতো মানুষের উক্তি বৈ নয়।", "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "sajda": false}, {"number": 26, "globalId": 5521, "arabic": "سَأُصْلِيهِ سَقَرَ", "bengali": "আমি তাকে দাখিল করব অগ্নিতে।", "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "sajda": false}, {"number": 27, "globalId": 5522, "arabic": "وَمَآ أَدْرَىٰكَ مَا سَقَرُ", "bengali": "আপনি কি বুঝলেন অগ্নি কি?", "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "sajda": false}, {"number": 28, "globalId": 5523, "arabic": "لَا تُبْقِى وَلَا تَذَرُ", "bengali": "এটা অক্ষত রাখবে না এবং ছাড়বেও না।", "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "sajda": false}, {"number": 29, "globalId": 5524, "arabic": "لَوَّاحَةٌۭ لِّلْبَشَرِ", "bengali": "মানুষকে দগ্ধ করবে।", "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "sajda": false}, {"number": 30, "globalId": 5525, "arabic": "عَلَيْهَا تِسْعَةَ عَشَرَ", "bengali": "এর উপর নিয়োজিত আছে উনিশ (ফেরেশতা)।", "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "sajda": false}, {"number": 31, "globalId": 5526, "arabic": "وَمَا جَعَلْنَآ أَصْحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةًۭ ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةًۭ لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَٰنًۭا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌۭ وَٱلْكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلًۭا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ", "bengali": "আমি জাহান্নামের তত্ত্বাবধায়ক ফেরেশতাই রেখেছি। আমি কাফেরদেরকে পরীক্ষা করার জন্যেই তার এই সংখ্যা করেছি-যাতে কিতাবীরা দৃঢ়বিশ্বাসী হয়, মুমিনদের ঈমান বৃদ্ধি পায় এবং কিতাবীরা ও মুমিনগণ সন্দেহ পোষণ না করে এবং যাতে যাদের অন্তরে রোগ আছে, তারা এবং কাফেররা বলে যে, আল্লাহ এর দ্বারা কি বোঝাতে চেয়েছেন। এমনিভাবে আল্লাহ যাকে ইচ্ছা পথভ্রষ্ট করেন এবং যাকে ইচ্ছা সৎপথে চালান। আপনার পালনকর্তার বাহিনী সম্পর্কে একমাত্র তিনিই জানেন এটা তো মানুষের জন্যে উপদেশ বৈ নয়।", "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "sajda": false}, {"number": 32, "globalId": 5527, "arabic": "كَلَّا وَٱلْقَمَرِ", "bengali": "কখনই নয়। চন্দ্রের শপথ,", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 33, "globalId": 5528, "arabic": "وَٱلَّيْلِ إِذْ أَدْبَرَ", "bengali": "শপথ রাত্রির যখন তার অবসান হয়,", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 34, "globalId": 5529, "arabic": "وَٱلصُّبْحِ إِذَآ أَسْفَرَ", "bengali": "শপথ প্রভাতকালের যখন তা আলোকোদ্ভাসিত হয়,", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 35, "globalId": 5530, "arabic": "إِنَّهَا لَإِحْدَى ٱلْكُبَرِ", "bengali": "নিশ্চয় জাহান্নাম গুরুতর বিপদসমূহের অন্যতম,", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 36, "globalId": 5531, "arabic": "نَذِيرًۭا لِّلْبَشَرِ", "bengali": "মানুষের জন্যে সতর্ককারী।", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 37, "globalId": 5532, "arabic": "لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ", "bengali": "তোমাদের মধ্যে যে সামনে অগ্রসর হয় অথবা পশ্চাতে থাকে।", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 38, "globalId": 5533, "arabic": "كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ", "bengali": "প্রত্যেক ব্যক্তি তার কৃতকর্মের জন্য দায়ী;", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 39, "globalId": 5534, "arabic": "إِلَّآ أَصْحَٰبَ ٱلْيَمِينِ", "bengali": "কিন্তু ডানদিকস্থরা,", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 40, "globalId": 5535, "arabic": "فِى جَنَّٰتٍۢ يَتَسَآءَلُونَ", "bengali": "তারা থাকবে জান্নাতে এবং পরস্পরে জিজ্ঞাসাবাদ করবে।", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 41, "globalId": 5536, "arabic": "عَنِ ٱلْمُجْرِمِينَ", "bengali": "অপরাধীদের সম্পর্কে", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 42, "globalId": 5537, "arabic": "مَا سَلَكَكُمْ فِى سَقَرَ", "bengali": "বলবেঃ তোমাদেরকে কিসে জাহান্নামে নীত করেছে?", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 43, "globalId": 5538, "arabic": "قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ", "bengali": "তারা বলবেঃ আমরা নামায পড়তাম না,", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 44, "globalId": 5539, "arabic": "وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ", "bengali": "অভাবগ্রস্তকে আহার্য্য দিতাম না,", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 45, "globalId": 5540, "arabic": "وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ", "bengali": "আমরা সমালোচকদের সাথে সমালোচনা করতাম।", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 46, "globalId": 5541, "arabic": "وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ", "bengali": "এবং আমরা প্রতিফল দিবসকে অস্বীকার করতাম।", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 47, "globalId": 5542, "arabic": "حَتَّىٰٓ أَتَىٰنَا ٱلْيَقِينُ", "bengali": "আমাদের মৃত্যু পর্যন্ত।", "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "sajda": false}, {"number": 48, "globalId": 5543, "arabic": "فَمَا تَنفَعُهُمْ شَفَٰعَةُ ٱلشَّٰفِعِينَ", "bengali": "অতএব, সুপারিশকারীদের সুপারিশ তাদের কোন উপকারে আসবে না।", "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "sajda": false}, {"number": 49, "globalId": 5544, "arabic": "فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ", "bengali": "তাদের কি হল যে, তারা উপদেশ থেকে মুখ ফিরিয়ে নেয়?", "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "sajda": false}, {"number": 50, "globalId": 5545, "arabic": "كَأَنَّهُمْ حُمُرٌۭ مُّسْتَنفِرَةٌۭ", "bengali": "যেন তারা ইতস্ততঃ বিক্ষিপ্ত গর্দভ।", "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "sajda": false}, {"number": 51, "globalId": 5546, "arabic": "فَرَّتْ مِن قَسْوَرَةٍۭ", "bengali": "হট্টগোলের কারণে পলায়নপর।", "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "sajda": false}, {"number": 52, "globalId": 5547, "arabic": "بَلْ يُرِيدُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًۭا مُّنَشَّرَةًۭ", "bengali": "বরং তাদের প্রত্যেকেই চায় তাদের প্রত্যেককে একটি উম্মুক্ত গ্রন্থ দেয়া হোক।", "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "sajda": false}, {"number": 53, "globalId": 5548, "arabic": "كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْءَاخِرَةَ", "bengali": "কখনও না, বরং তারা পরকালকে ভয় করে না।", "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "sajda": false}, {"number": 54, "globalId": 5549, "arabic": "كَلَّآ إِنَّهُۥ تَذْكِرَةٌۭ", "bengali": "কখনও না, এটা তো উপদেশ মাত্র।", "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "sajda": false}, {"number": 55, "globalId": 5550, "arabic": "فَمَن شَآءَ ذَكَرَهُۥ", "bengali": "অতএব, যার ইচ্ছা, সে একে স্মরণ করুক।", "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "sajda": false}, {"number": 56, "globalId": 5551, "arabic": "وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ", "bengali": "তারা স্মরণ করবে না, কিন্তু যদি আল্লাহ চান। তিনিই ভয়ের যোগ্য এবং ক্ষমার অধিকারী।", "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "sajda": false}]}